{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandboxProfile",
  "type": "object",
  "properties": {
    "approval_policy": {
      "$ref": "#/$defs/ApprovalPolicy"
    },
    "filesystem": {
      "$ref": "#/$defs/FilesystemAccess"
    },
    "isolated_runner": {
      "type": "boolean"
    },
    "isolation": {
      "$ref": "#/$defs/SandboxIsolationProfile",
      "default": {
        "apparmor_profile": null,
        "backend": "local_workspace",
        "cpu_limit_millis": null,
        "drop_capabilities": [],
        "egress_policy_ref": null,
        "enforce": false,
        "image": null,
        "ingress_policy_ref": null,
        "memory_limit_mb": null,
        "network_policy_labels": {},
        "no_new_privileges": true,
        "pids_limit": null,
        "read_only_rootfs": false,
        "runtime_class": null,
        "seccomp_profile": null,
        "snapshot_strategy": "filesystem_manifest"
      }
    },
    "network": {
      "$ref": "#/$defs/NetworkAccess"
    }
  },
  "required": [
    "filesystem",
    "network",
    "approval_policy",
    "isolated_runner"
  ],
  "$defs": {
    "ApprovalPolicy": {
      "type": "string",
      "enum": [
        "never",
        "on_request",
        "always"
      ]
    },
    "FilesystemAccess": {
      "type": "string",
      "enum": [
        "read_only",
        "workspace_write"
      ]
    },
    "NetworkAccess": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "open"
      ]
    },
    "SandboxBackend": {
      "type": "string",
      "enum": [
        "local_workspace",
        "container",
        "gvisor",
        "firecracker",
        "kata",
        "kubernetes_job",
        "namespace_jail",
        "provider_sandbox"
      ]
    },
    "SandboxIsolationProfile": {
      "type": "object",
      "properties": {
        "apparmor_profile": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "backend": {
          "$ref": "#/$defs/SandboxBackend",
          "default": "local_workspace"
        },
        "cpu_limit_millis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "drop_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "egress_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "enforce": {
          "type": "boolean",
          "default": false
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "ingress_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "memory_limit_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "network_policy_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "no_new_privileges": {
          "type": "boolean",
          "default": true
        },
        "pids_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "read_only_rootfs": {
          "type": "boolean",
          "default": false
        },
        "runtime_class": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "seccomp_profile": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "snapshot_strategy": {
          "$ref": "#/$defs/SandboxSnapshotStrategy",
          "default": "filesystem_manifest"
        }
      }
    },
    "SandboxSnapshotStrategy": {
      "type": "string",
      "enum": [
        "metadata_only",
        "filesystem_manifest",
        "archive",
        "object_storage_archive"
      ]
    }
  }
}
