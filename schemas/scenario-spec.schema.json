{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jattg.dev/schemas/scenario-spec.schema.json",
  "title": "COAT ScenarioSpec",
  "description": "Deterministic E2E scenario contract for the COAT durable task-graph compiler.",
  "type": "object",
  "required": ["id", "title", "determinism", "goals", "actions", "expected_terminal_state", "evaluator_checks"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "determinism": {
      "type": "object",
      "required": ["mode", "live_provider_credentials_required", "network_required"],
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string" },
        "clock_start": { "type": "string" },
        "seed": { "type": "integer" },
        "live_provider_credentials_required": { "type": "boolean" },
        "network_required": { "type": "boolean" },
        "stub_runner_id": { "type": "string" },
        "projection_mode": { "type": "string" }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mode"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "mode": { "type": "string" },
          "required": { "type": "boolean" },
          "endpoint": {},
          "fixtures": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fixtures": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "stub_projections": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["goal_id", "spec"],
        "additionalProperties": true,
        "properties": {
          "goal_id": { "type": "string" },
          "creation": { "type": "string" },
          "spec": {
            "type": "object",
            "required": ["title", "objective", "initial_tasks"],
            "additionalProperties": true
          },
          "projection_fixture": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "submit_goal",
              "emit_external_event",
              "inject_worker_result",
              "inject_worker_results",
              "resume_delayed_compute",
              "iteration_fixture",
              "validate_goal"
            ]
          },
          "description": { "type": "string" },
          "service": { "type": "string" },
          "goal_id": { "type": "string" },
          "task_id": { "type": "string" },
          "after": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expect": { "type": "object", "additionalProperties": true },
          "worker_result": { "type": "object", "additionalProperties": true },
          "worker_results": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "expected_terminal_state": {
      "type": "object",
      "required": ["goal_status", "task_counts", "required_events", "required_artifacts"],
      "additionalProperties": true,
      "properties": {
        "goal_status": { "type": "string" },
        "task_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "required_events": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "satisfaction": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "min_score": { "type": "number" },
            "actual_score": { "type": "number" },
            "required": { "type": "boolean" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "usability_coherence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_visible_terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "goal",
              "subgoal",
              "task",
              "thunk",
              "fork",
              "review",
              "evidence",
              "action",
              "completed"
            ]
          }
        },
        "blocked_operator_action_required": { "type": "boolean" },
        "completed_evidence_required": { "type": "boolean" },
        "completed_satisfaction_rationale_required": { "type": "boolean" }
      }
    },
    "evaluator_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "assertion", "expected", "required"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "assertion": { "type": "string" },
          "expected": {},
          "required": { "type": "boolean" }
        }
      }
    },
    "timeout": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": true }
      ]
    },
    "artifact_policy": { "type": "object", "additionalProperties": true }
  }
}
