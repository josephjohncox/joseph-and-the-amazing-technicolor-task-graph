{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubgoalSpec",
  "type": "object",
  "properties": {
    "acceptance_evidence": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "owner_role": {
      "$ref": "#/$defs/WorkerKind"
    },
    "priority": {
      "$ref": "#/$defs/TaskPriority",
      "default": "normal"
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "objective",
    "owner_role"
  ],
  "$defs": {
    "TaskPriority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
