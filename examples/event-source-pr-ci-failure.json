{
  "id": "pr-ci-failures",
  "kind": "ci_test_failure",
  "enabled": true,
  "description": "PR test failure events from GitHub Actions, another CI system, or a normalized event bus.",
  "namespace": "coat",
  "webhook": null,
  "generic": {
    "auth": {
      "kind": "bearer_token",
      "secret_ref": {
        "provider": "env",
        "name": "COAT_CI_SIGNAL_TOKEN",
        "key": null,
        "namespace": null,
        "audience": "coat-event-gateway"
      },
      "header_name": "authorization"
    },
    "accepts_cloudevents": true,
    "max_payload_bytes": 1048576,
    "allowed_event_types": [
      "ci.test.failed",
      "ci.workflow.failed",
      "github.workflow_run.completed",
      "github.check_run.completed"
    ],
    "id_json_pointer": "/run_id",
    "type_json_pointer": "/type",
    "subject_json_pointer": "/subject",
    "dedupe_json_pointer": "/dedupe_key",
    "dedupe_header": "ce-id",
    "payload_schema": null,
    "mcp_context": null
  },
  "schedule": null,
  "calendar": null,
  "route": {
    "mode": "create_goal",
    "goal_template": {
      "title_template": "Fix PR test failure for {{subject}}",
      "objective_template": "Investigate CI failure {{event_id}} for {{subject}}. Use branch and PR context from payload._coat_change_activity, inspect recent memory for recurring failures, reproduce or explain the failed tests, propose or apply a bounded fix, and return evidence from the relevant test commands.",
      "repo": "example/repo",
      "worker_role": "tester",
      "tags": [
        "ci",
        "pr",
        "test-failure",
        "human-branch"
      ]
    },
    "target_goal_id": null,
    "steering_directive": null,
    "require_approval": false,
    "dedupe_window_seconds": 3600
  }
}
