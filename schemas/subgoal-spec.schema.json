{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubgoalSpec",
  "type": "object",
  "properties": {
    "acceptance_evidence": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "color": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphColorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "owner_role": {
      "$ref": "#/$defs/WorkerKind"
    },
    "priority": {
      "$ref": "#/$defs/TaskPriority",
      "default": "normal"
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "objective",
    "owner_role"
  ],
  "$defs": {
    "GraphColorRef": {
      "description": "Stable visual metadata for the Technicolor Task Graph.\n\nColors are semantic graph state, not dashboard decoration. They let\noperators, reviewers, dashboards, and MCP clients preserve a consistent\nlegend across task projections, branches, reviews, and subgoals.",
      "type": "object",
      "properties": {
        "hex": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "hex",
        "meaning"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
