{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventGoalRoute",
  "type": "object",
  "properties": {
    "dedupe_window_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "goal_template": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalTriggerTemplate"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "$ref": "#/$defs/EventRouteMode"
    },
    "require_approval": {
      "type": "boolean"
    },
    "steering_directive": {
      "anyOf": [
        {
          "$ref": "#/$defs/SteeringDirective"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_goal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "mode",
    "require_approval",
    "dedupe_window_seconds"
  ],
  "$defs": {
    "AuthDistributionMode": {
      "type": "string",
      "enum": [
        "runner_local_only",
        "runner_resolves_refs",
        "coordinator_issues_lease",
        "workload_identity",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "AuthDistributionPolicy": {
      "type": "object",
      "properties": {
        "allow_node_local_device_session": {
          "type": "boolean"
        },
        "allow_secret_sync": {
          "type": "boolean"
        },
        "allowed_materials": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AuthMaterialKind"
          }
        },
        "lease_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/AuthDistributionMode"
        },
        "renewal": {
          "$ref": "#/$defs/AuthRenewalPolicy"
        },
        "require_human_approval_for_brokered_user_auth": {
          "type": "boolean"
        },
        "required_runner_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "mode",
        "renewal",
        "allow_node_local_device_session",
        "allow_secret_sync",
        "require_human_approval_for_brokered_user_auth"
      ]
    },
    "AuthMaterialKind": {
      "type": "string",
      "enum": [
        "api_token",
        "mcp_bearer_token",
        "oauth_access_token",
        "oauth_refresh_token",
        "oidc_id_token",
        "oidc_access_token",
        "oidc_refresh_token",
        "oidc_on_behalf_of_token",
        "device_auth_session",
        "workload_identity_token",
        "local_cli_session",
        "service_account",
        "other"
      ]
    },
    "AuthRenewalPolicy": {
      "type": "string",
      "enum": [
        "none",
        "manual_or_brokered",
        "broker_can_refresh",
        "runner_can_refresh"
      ]
    },
    "Budget": {
      "type": "object",
      "properties": {
        "max_child_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_patch_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_runtime_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remaining_child_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "remaining_runtime_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remaining_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remaining_tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "max_tokens",
        "remaining_tokens",
        "max_runtime_seconds",
        "remaining_runtime_seconds",
        "max_tool_calls",
        "remaining_tool_calls",
        "max_child_tasks",
        "remaining_child_tasks",
        "max_patch_size"
      ]
    },
    "ChildTaskRequestChannel": {
      "type": "string",
      "enum": [
        "agent_run_result_child_requests"
      ]
    },
    "DeviceAuthProvider": {
      "type": "string",
      "enum": [
        "codex",
        "claude_code",
        "open_ai",
        "anthropic",
        "github",
        "google",
        "other"
      ]
    },
    "DoneCriteria": {
      "type": "object",
      "properties": {
        "artifact_exists": {
          "type": "boolean"
        },
        "tests_pass": {
          "type": "boolean"
        },
        "validator_score_min": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "required": [
        "tests_pass",
        "artifact_exists"
      ]
    },
    "EventRouteMode": {
      "type": "string",
      "enum": [
        "record_only",
        "create_goal",
        "create_research_goal",
        "steer_goal",
        "human_review"
      ]
    },
    "ExecutionProfile": {
      "description": "Task-local runner, model, persona, MCP, notification, result, and guardrail policy.\n\nThis is the contract that lets distributed runners and model providers pick\nup work without reading global plan prose. It is documented in\n`docs/design-docs/010-distributed-runners-mcp.md`.",
      "type": "object",
      "properties": {
        "guardrails": {
          "$ref": "#/$defs/ExecutorGuardrailPolicy",
          "default": {
            "block_on_high_findings": true,
            "enabled": false,
            "max_inline_output_bytes": 65536,
            "output_reviewer_role": "reviewer",
            "redact_secrets": true,
            "require_artifact_manifest": false,
            "require_output_review": false,
            "require_sandbox_attestation": false,
            "require_security_review": false,
            "require_strong_sandbox_attestation": false,
            "security_reviewer_role": "validator"
          }
        },
        "mcp": {
          "$ref": "#/$defs/McpContextRef"
        },
        "model": {
          "$ref": "#/$defs/ModelRoute"
        },
        "notifications": {
          "$ref": "#/$defs/NotificationPolicy"
        },
        "persona": {
          "$ref": "#/$defs/PersonaSpec"
        },
        "results": {
          "$ref": "#/$defs/ResultChannelPolicy",
          "default": {
            "git": {
              "base_ref": "HEAD",
              "branch_prefix": "coat/task",
              "enabled": false,
              "include_patch_artifact": true,
              "push_on_success": false,
              "remote": "origin",
              "require_clean_diff": true,
              "worktree_root": "/worktrees"
            },
            "object_storage": {
              "enabled": false,
              "key_prefix_template": "goals/{goal_id}/tasks/{task_id}",
              "max_inline_bytes": 262144,
              "require_manifest": true,
              "store": null
            }
          }
        },
        "runner": {
          "$ref": "#/$defs/RunnerSelector"
        },
        "subagents": {
          "$ref": "#/$defs/SubagentDelegationPolicy",
          "default": {
            "child_request_channel": "agent_run_result_child_requests",
            "inject_runner_context": true,
            "mode": "coordinator_durable_tasks",
            "native_spawn": "disabled"
          }
        }
      },
      "required": [
        "runner",
        "model",
        "persona",
        "mcp",
        "notifications"
      ]
    },
    "ExecutorGuardrailPolicy": {
      "type": "object",
      "properties": {
        "block_on_high_findings": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_inline_output_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_reviewer_role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "redact_secrets": {
          "type": "boolean"
        },
        "require_artifact_manifest": {
          "type": "boolean"
        },
        "require_output_review": {
          "type": "boolean"
        },
        "require_sandbox_attestation": {
          "type": "boolean"
        },
        "require_security_review": {
          "type": "boolean"
        },
        "require_strong_sandbox_attestation": {
          "type": "boolean"
        },
        "security_reviewer_role": {
          "$ref": "#/$defs/WorkerKind"
        }
      },
      "required": [
        "enabled",
        "require_output_review",
        "require_security_review",
        "output_reviewer_role",
        "security_reviewer_role",
        "block_on_high_findings",
        "require_artifact_manifest",
        "require_sandbox_attestation",
        "require_strong_sandbox_attestation",
        "redact_secrets",
        "max_inline_output_bytes"
      ]
    },
    "GitResultPolicy": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_prefix": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "include_patch_artifact": {
          "type": "boolean"
        },
        "push_on_success": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_clean_diff": {
          "type": "boolean"
        },
        "worktree_root": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled",
        "branch_prefix",
        "push_on_success",
        "require_clean_diff",
        "include_patch_artifact"
      ]
    },
    "GoalTriggerTemplate": {
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "done_criteria": {
          "$ref": "#/$defs/DoneCriteria"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionProfile"
        },
        "objective_template": {
          "type": "string"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "title_template": {
          "type": "string"
        },
        "worker_role": {
          "$ref": "#/$defs/WorkerKind"
        }
      },
      "required": [
        "title_template",
        "objective_template",
        "worker_role",
        "done_criteria",
        "budget",
        "execution"
      ]
    },
    "McpAccessMode": {
      "type": "string",
      "enum": [
        "single_user",
        "multi_user_oidc"
      ]
    },
    "McpAuthRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secret"
            },
            "secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "workload_identity"
            }
          },
          "required": [
            "kind",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oauth_delegation"
            },
            "token_exchange_secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "token_exchange_secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "issuer": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "oidc_delegation"
            },
            "principal": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UserPrincipalRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "require_user_consent": {
              "type": "boolean",
              "default": true
            },
            "token_ttl_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "broker",
            "issuer",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "device_auth_session"
            },
            "node_local": {
              "type": "boolean",
              "default": true
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "refresh_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "session_ref": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "session_ref",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "kind": {
              "type": "string",
              "const": "brokered_user_session"
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "broker",
            "provider"
          ]
        }
      ]
    },
    "McpContextPropagation": {
      "type": "string",
      "enum": [
        "coordinator_issued",
        "runner_resolves_refs",
        "workload_identity",
        "runner_local_only",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "McpContextRef": {
      "description": "MCP context distributed by reference, never by raw credential value.\n\nThe coordinator stores server refs, allowed tools, secret refs, optional\nuser principal refs, and auth-distribution policy. Runners resolve usable\ncredentials locally or through brokers. See\n`docs/design-docs/040-auth-distribution.md` and\n`docs/design-docs/130-multi-user-oidc-mcp.md`.",
      "type": "object",
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/McpAccessMode",
          "default": "single_user"
        },
        "auth_distribution": {
          "$ref": "#/$defs/AuthDistributionPolicy",
          "default": {
            "allow_node_local_device_session": true,
            "allow_secret_sync": false,
            "allowed_materials": [
              "api_token",
              "mcp_bearer_token",
              "oauth_access_token",
              "oauth_refresh_token",
              "workload_identity_token"
            ],
            "lease_ttl_seconds": 900,
            "mode": "runner_resolves_refs",
            "renewal": "manual_or_brokered",
            "require_human_approval_for_brokered_user_auth": true,
            "required_runner_labels": {}
          }
        },
        "context_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "oidc_delegation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcDelegationPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "propagation": {
          "$ref": "#/$defs/McpContextPropagation"
        },
        "secret_refs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        },
        "servers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/McpServerRef"
          }
        },
        "token_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserPrincipalRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "propagation"
      ]
    },
    "McpServerRef": {
      "type": "object",
      "properties": {
        "allowed_tools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "$ref": "#/$defs/McpAuthRef"
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "transport",
        "uri",
        "auth"
      ]
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "ModelCandidate": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "model": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "provider": {
          "$ref": "#/$defs/ModelProviderKind"
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "model",
        "priority",
        "weight"
      ]
    },
    "ModelFallbackPolicy": {
      "type": "string",
      "enum": [
        "disallow_fallback",
        "allow_fallback",
        "allow_lower_tier_local"
      ]
    },
    "ModelFeature": {
      "type": "string",
      "enum": [
        "tool_use",
        "json_schema",
        "streaming",
        "vision",
        "long_context",
        "reasoning",
        "embeddings",
        "local_weights"
      ]
    },
    "ModelProviderKind": {
      "type": "string",
      "enum": [
        "codex",
        "open_ai",
        "open_ai_compatible",
        "vllm",
        "ollama",
        "llama_cpp",
        "anthropic",
        "hugging_face",
        "local_process",
        "other"
      ]
    },
    "ModelRoute": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelCandidate"
          }
        },
        "fallback": {
          "$ref": "#/$defs/ModelFallbackPolicy"
        },
        "required_features": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "strategy": {
          "$ref": "#/$defs/ModelRoutingStrategy"
        }
      },
      "required": [
        "strategy",
        "fallback"
      ]
    },
    "ModelRoutingStrategy": {
      "type": "string",
      "enum": [
        "first_available",
        "lowest_latency",
        "lowest_cost",
        "highest_quality",
        "weighted",
        "sticky_per_goal"
      ]
    },
    "NativeSubagentSpawnPolicy": {
      "type": "string",
      "enum": [
        "disabled",
        "requires_approval",
        "allowed"
      ]
    },
    "NotificationEvent": {
      "type": "string",
      "enum": [
        "human_feedback_requested",
        "approval_requested",
        "task_blocked",
        "task_failed",
        "goal_completed",
        "budget_warning",
        "runner_lost"
      ]
    },
    "NotificationPolicy": {
      "type": "object",
      "properties": {
        "escalation_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotificationEvent"
          }
        },
        "feedback_thread_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/NotificationTarget"
          }
        }
      }
    },
    "NotificationTarget": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NotificationTargetKind"
        },
        "require_ack": {
          "type": "boolean"
        },
        "secret_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "address",
        "require_ack"
      ]
    },
    "NotificationTargetKind": {
      "type": "string",
      "enum": [
        "thread",
        "webhook",
        "slack",
        "email",
        "git_hub",
        "linear",
        "jira",
        "pager_duty",
        "other"
      ]
    },
    "ObjectStoragePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "key_prefix_template": {
          "type": "string"
        },
        "max_inline_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "require_manifest": {
          "type": "boolean"
        },
        "store": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectStoreRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "key_prefix_template",
        "require_manifest",
