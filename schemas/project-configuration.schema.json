{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoatProjectConfig",
  "description": "Project-local COAT configuration stored at `.coat/project.json`.\n\nThis file is meant to be committed when a checkout wants shared non-secret\ndefaults. Machine-local credentials, user tokens, and workstation-specific\noverrides belong in `~/.coat/config.json`, environment variables, or secret\nproviders.",
  "type": "object",
  "properties": {
    "cli": {
      "type": "string",
      "default": "coat"
    },
    "config": {
      "$ref": "#/$defs/CoatConfig",
      "default": {}
    },
    "package_slug": {
      "type": "string",
      "default": "jattg"
    },
    "project": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "default": ""
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "default": 1,
      "minimum": 0
    }
  },
  "required": [
    "project"
  ],
  "$defs": {
    "CapacityScalingMode": {
      "type": "string",
      "enum": [
        "manual",
        "recommend_only",
        "provision_ephemeral"
      ]
    },
    "CapacityScalingPolicy": {
      "description": "Bounded policy for dynamically adding or retiring runner capacity.\n\nThe coordinator computes durable demand from runnable tasks, events, and\nqueue processors. A provisioner may realize the resulting recommendations,\nbut only within these limits and the surrounding approval policy.",
      "type": "object",
      "properties": {
        "cooldown_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "event_weight": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "headroom_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "max_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 8,
          "minimum": 0
        },
        "max_scale_down_step": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "max_scale_up_step": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "min_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/CapacityScalingMode",
          "default": "recommend_only"
        },
        "scale_from_events": {
          "type": "boolean",
          "default": true
        },
        "slots_per_runner": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "target_backlog_per_runner": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "target_utilization_percent": {
          "type": "integer",
          "format": "uint32",
          "default": 75,
          "minimum": 0
        }
      }
    },
    "CoatCliConfig": {
      "type": "object",
      "properties": {
        "interactive_setup": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "output_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_project_for_durable_commands": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "warn_uninitialized": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "CoatCloudConfig": {
      "type": "object",
      "properties": {
        "object_store": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoatCloudProvider"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "restate_cloud": {
          "$ref": "#/$defs/CoatRestateCloudConfig"
        },
        "secret_provider": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatCloudProvider": {
      "type": "string",
      "enum": [
        "local",
        "restate_cloud",
        "aws",
        "other"
      ]
    },
    "CoatConfig": {
      "description": "Standard non-secret configuration shared by project and user config files.",
      "type": "object",
      "properties": {
        "active_profile": {
          "description": "Profile name applied after project and user config are merged.\n\nOperators can override this with `COAT_PROFILE` for one shell/session.",
          "type": [
            "string",
            "null"
          ]
        },
        "cli": {
          "$ref": "#/$defs/CoatCliConfig"
        },
        "cloud": {
          "$ref": "#/$defs/CoatCloudConfig"
        },
        "defaults": {
          "$ref": "#/$defs/CoatOperatorDefaults"
        },
        "kubernetes": {
          "$ref": "#/$defs/CoatKubernetesConfig"
        },
        "local_deploy": {
          "$ref": "#/$defs/CoatLocalDeployConfig"
        },
        "model_routing": {
          "$ref": "#/$defs/CoatModelRoutingConfig"
        },
        "paths": {
          "$ref": "#/$defs/CoatConfigPaths"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoatProfileConfig"
          }
        },
        "runner_capacity": {
          "$ref": "#/$defs/CoatRunnerCapacityConfig"
        },
        "service_endpoints": {
          "$ref": "#/$defs/CoatServiceEndpoints"
        },
        "tool_routing": {
          "$ref": "#/$defs/CoatToolRoutingConfig"
        }
      }
    },
    "CoatConfigPaths": {
      "type": "object",
      "properties": {
        "cache_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_provider_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "restate_cloud_env": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatKubernetesConfig": {
      "type": "object",
      "properties": {
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoatKubernetesDistribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "helm_chart": {
          "type": [
            "string",
            "null"
          ]
        },
        "helm_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "helm_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image_registry": {
          "type": [
            "string",
            "null"
          ]
        },
        "kubeconfig": {
          "type": [
            "string",
            "null"
          ]
        },
        "kubectl": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_store": {
          "type": [
            "string",
            "null"
          ]
        },
        "rendered_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_account": {
          "type": [
            "string",
            "null"
          ]
        },
        "workload_identity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatKubernetesDistribution": {
      "type": "string",
      "enum": [
        "eks",
        "generic",
        "kind",
        "k3s",
        "gke",
        "aks"
      ]
    },
    "CoatLlmGatewayConfig": {
      "type": "object",
      "properties": {
        "auth_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "chat_completions_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "chat_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoatLlmGatewayProvider"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        },
        "work_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatLlmGatewayProvider": {
      "type": "string",
      "enum": [
        "bifrost",
        "lite_llm",
        "open_router",
        "docker_model_gateway",
        "open_ai_compatible",
        "custom"
      ]
    },
    "CoatLocalDeployConfig": {
      "type": "object",
      "properties": {
        "allow_stub_runners": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allow_uninitialized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "env_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restate_cloud_env_file": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatModelRoutingConfig": {
      "description": "Non-secret model routing defaults shared by CLI setup, runners, and UI.\n\nStore raw provider tokens in env vars, Kubernetes Secrets, external secret\nstores, or brokered leases. This config only records which env/secret refs\nshould be resolved at runtime and which model lanes should prefer a shared\ngateway versus direct provider credentials.",
      "type": "object",
      "properties": {
        "direct_provider_secret_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        },
        "gateway": {
          "$ref": "#/$defs/CoatLlmGatewayConfig"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoatModelRoutingMode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CoatModelRoutingMode": {
      "type": "string",
      "enum": [
        "direct_providers",
        "shared_gateway",
        "hybrid"
      ]
    },
    "CoatOperatorDefaults": {
      "type": "object",
      "properties": {
        "goal_store_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_goal_selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "restate_ingress": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatProfileConfig": {
      "type": "object",
      "properties": {
        "cli": {
          "$ref": "#/$defs/CoatCliConfig"
        },
        "cloud": {
          "$ref": "#/$defs/CoatCloudConfig"
        },
        "defaults": {
          "$ref": "#/$defs/CoatOperatorDefaults"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CoatProfileKind"
        },
        "kubernetes": {
          "$ref": "#/$defs/CoatKubernetesConfig"
        },
        "local_deploy": {
          "$ref": "#/$defs/CoatLocalDeployConfig"
        },
        "model_routing": {
          "$ref": "#/$defs/CoatModelRoutingConfig"
        },
        "name": {
          "type": "string"
        },
        "paths": {
          "$ref": "#/$defs/CoatConfigPaths"
        },
        "runner_capacity": {
          "$ref": "#/$defs/CoatRunnerCapacityConfig"
        },
        "service_endpoints": {
          "$ref": "#/$defs/CoatServiceEndpoints"
        },
        "tool_routing": {
          "$ref": "#/$defs/CoatToolRoutingConfig"
        }
      },
      "required": [
        "name",
        "kind"
      ]
    },
    "CoatProfileKind": {
      "type": "string",
      "enum": [
        "cli",
        "local_compose",
        "restate_cloud",
        "eks",
        "kubernetes"
      ]
    },
    "CoatRestateCloudConfig": {
      "type": "object",
      "properties": {
        "coordinator_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "env_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_admin_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_ingress_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "tunnel_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatRunnerCapacityConfig": {
      "description": "Non-secret capacity scaling defaults for runner pools.\n\nThis is operator policy, not live task state. The coordinator derives actual\ndemand from durable tasks and event queues, then applies these caps before\nasking a provisioner to add ephemeral runners or drain idle capacity.",
      "type": "object",
      "properties": {
        "default_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapacityScalingPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "lane_policies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CapacityScalingPolicy"
          }
        }
      }
    },
    "CoatServiceEndpoints": {
      "type": "object",
      "properties": {
        "control_mcp_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "coordinator_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_gateway_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal_store_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_gateway_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "notifier_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "restate_admin": {
          "type": [
            "string",
            "null"
          ]
        },
        "restate_ingress": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_registry_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox_runner_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_registry_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CoatToolRoutingConfig": {
      "description": "Non-secret tool routing defaults shared by MCP servers, setup flows, and runners.\n\nThis config decides which durable route is allowed for tool-shaped work such\nas web/reference search. It does not store provider tokens; use `auth_env`,\n`secret_refs`, or an external broker.",
      "type": "object",
      "properties": {
        "web_search": {
          "$ref": "#/$defs/CoatWebSearchRoutingConfig"
        }
      }
    },
    "CoatWebSearchRoutingConfig": {
      "type": "object",
      "properties": {
        "auth_env": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "max_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebSearchRoutingMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebSearchProviderKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunnerCapability"
          }
        },
        "required_model_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "route_via_runner_registry": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        }
      }
    },
    "ModelFeature": {
      "type": "string",
      "enum": [
        "tool_use",
        "json_schema",
        "streaming",
        "vision",
        "long_context",
        "reasoning",
        "embeddings",
        "local_weights",
        "web_search"
      ]
    },
    "RunnerCapability": {
      "type": "string",
      "enum": [
        "code",
        "research",
        "web_search",
        "test",
        "review",
        "mcp_tools",
        "durable_child_tasks",
        "oidc_user_delegation",
        "local_commands",
        "git_cli",
        "docker_cli",
        "helm_cli",
        "kubernetes_cli",
        "build_tooling",
        "package_manager_cli",
        "workspace_sandbox",
        "container_sandbox",
        "gvisor_sandbox",
        "firecracker_sandbox",
        "kata_sandbox",
        "kubernetes_job_sandbox",
        "namespace_jail_sandbox",
        "provider_sandbox",
        "git_worktree",
        "git",
        "object_storage",
        "s3_compatible",
        "browser",
        "notifications",
        "local_models",
        "vllm",
        "open_ai_compatible",
        "gpu",
        "ephemeral_provisioning",
        "network_open",
        "formal_verification"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "WebSearchProviderKind": {
      "type": "string",
      "enum": [
        "agent_native",
        "mcp_gateway",
        "search_api",
        "custom",
        "other"
      ]
    },
    "WebSearchRoutingMode": {
      "type": "string",
      "enum": [
        "disabled",
        "coordinator_task",
        "runner_registry"
      ]
    }
  }
}
