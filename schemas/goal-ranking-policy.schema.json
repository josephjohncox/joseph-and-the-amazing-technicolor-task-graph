{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalRankingPolicy",
  "description": "Optional extension for human/coordinator voting over goal priority.\n\nRanking votes are durable coordinator state. They can promote a goal into an\noverarching initiative, demote it into a subgoal, or leave it as a peer goal\nfor frontier ordering and operator views.",
  "type": "object",
  "properties": {
    "allow_agent_votes": {
      "type": "boolean"
    },
    "allow_coordinator_votes": {
      "type": "boolean"
    },
    "allow_human_votes": {
      "type": "boolean"
    },
    "demotion_score": {
      "type": "integer",
      "format": "int32"
    },
    "enabled": {
      "type": "boolean"
    },
    "max_vote_weight": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "min_votes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "promotion_score": {
      "type": "integer",
      "format": "int32"
    }
  },
  "required": [
    "enabled",
    "allow_human_votes",
    "allow_coordinator_votes",
    "allow_agent_votes",
    "min_votes",
    "promotion_score",
    "demotion_score",
    "max_vote_weight"
  ]
}
