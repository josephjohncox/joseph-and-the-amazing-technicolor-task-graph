{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryWriteRequest",
  "type": "object",
  "properties": {
    "episode": {
      "$ref": "#/$defs/MemoryEpisode"
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "$ref": "#/$defs/MemoryScope"
    },
    "store": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryStoreRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "goal_id",
    "scope",
    "episode"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "patch",
        "test_result",
        "report",
        "pull_request",
        "workspace_snapshot",
        "checkpoint",
        "git_branch",
        "git_commit",
        "git_worktree",
        "object_storage_object",
        "object_storage_prefix",
        "artifact_manifest",
        "schema",
        "other"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "description"
      ]
    },
    "MemoryEpisode": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "content": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MemoryEpisodeSource"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "content",
        "source"
      ]
    },
    "MemoryEpisodeSource": {
      "type": "object",
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "$ref": "#/$defs/MemoryEpisodeSourceType"
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_type"
      ]
    },
    "MemoryEpisodeSourceType": {
      "type": "string",
      "enum": [
        "actor",
        "critic",
        "unifier",
        "research",
        "human",
        "tool",
        "system"
      ]
    },
    "MemoryScope": {
      "type": "string",
      "enum": [
        "goal",
        "task",
        "repo",
        "persona",
        "user",
        "global"
      ]
    },
    "MemoryStoreKind": {
      "type": "string",
      "enum": [
        "zep_graphiti",
        "letta",
        "postgres_pgvector",
        "qdrant",
        "lance_db",
        "sqlite",
        "other"
      ]
    },
    "MemoryStoreRef": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MemoryStoreKind"
        },
        "mcp_server_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_refs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    }
  }
}
