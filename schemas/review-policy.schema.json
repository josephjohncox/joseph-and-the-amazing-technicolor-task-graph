{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPolicy",
  "type": "object",
  "properties": {
    "actor_critic": {
      "$ref": "#/$defs/ActorCriticPolicy"
    },
    "enabled": {
      "type": "boolean"
    },
    "join_strategy": {
      "$ref": "#/$defs/ReviewJoinStrategy"
    },
    "max_review_rounds": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "min_reviews": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "min_satisfaction_score": {
      "type": "number",
      "format": "float"
    },
    "require_unification": {
      "type": "boolean"
    },
    "reviewer_roles": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkerKind"
      }
    },
    "unifier_role": {
      "$ref": "#/$defs/WorkerKind"
    }
  },
  "required": [
    "enabled",
    "min_reviews",
    "max_review_rounds",
    "join_strategy",
    "require_unification",
    "unifier_role",
    "min_satisfaction_score",
    "actor_critic"
  ],
  "$defs": {
    "ActorCriticPolicy": {
      "type": "object",
      "properties": {
        "actor_retry_role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "critic_role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_actor_retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reward_threshold": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "enabled",
        "critic_role",
        "actor_retry_role",
        "max_actor_retries",
        "reward_threshold"
      ]
    },
    "ReviewJoinStrategy": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "all_required",
            "any_required"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quorum": {
              "type": "object",
              "properties": {
                "min_passed": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "min_passed"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "quorum"
          ]
        }
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
