{
  "id": "branch-activity",
  "kind": "branch_activity",
  "enabled": true,
  "description": "Branch activity emitted by a local git watcher, repository host webhook, or developer workstation bridge.",
  "namespace": "coat",
  "webhook": null,
  "generic": {
    "auth": {
      "kind": "bearer_token",
      "secret_ref": {
        "provider": "env",
        "name": "COAT_BRANCH_SIGNAL_TOKEN",
        "key": null,
        "namespace": null,
        "audience": "coat-event-gateway"
      },
      "header_name": "authorization"
    },
    "accepts_cloudevents": true,
    "max_payload_bytes": 1048576,
    "allowed_event_types": [
      "branch.updated",
      "branch.deleted",
      "branch.pushed",
      "branch.ready_for_review"
    ],
    "id_json_pointer": "/id",
    "type_json_pointer": "/type",
    "subject_json_pointer": "/subject",
    "dedupe_json_pointer": "/dedupe_key",
    "dedupe_header": "ce-id",
    "payload_schema": null,
    "mcp_context": null
  },
  "schedule": null,
  "calendar": null,
  "route": {
    "mode": "record_only",
    "goal_template": null,
    "target_goal_id": null,
    "steering_directive": null,
    "require_approval": false,
    "dedupe_window_seconds": 300
  }
}
