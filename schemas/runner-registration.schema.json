{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunnerRegistration",
  "description": "Runner-advertised capacity, model inventory, labels, MCP servers, and capabilities.\n\nThe registry and coordinator use this to route a `TaskNode` by role,\ncapability, locality, labels, model route, MCP context, and auth policy.",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RunnerCapability"
      }
    },
    "endpoint": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "lease_ttl_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "max_concurrency": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mcp_servers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/McpServerRef"
      }
    },
    "models": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelCandidate"
      }
    },
    "node_id": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkerKind"
      }
    },
    "runner_id": {
      "type": "string"
    }
  },
  "required": [
    "runner_id",
    "node_id",
    "endpoint",
    "max_concurrency",
    "lease_ttl_seconds"
  ],
  "$defs": {
    "DeviceAuthProvider": {
      "type": "string",
      "enum": [
        "codex",
        "claude_code",
        "open_ai",
        "anthropic",
        "github",
        "google",
        "other"
      ]
    },
    "McpAuthRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secret"
            },
            "secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "workload_identity"
            }
          },
          "required": [
            "kind",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oauth_delegation"
            },
            "token_exchange_secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "token_exchange_secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "issuer": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "oidc_delegation"
            },
            "principal": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UserPrincipalRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "require_user_consent": {
              "type": "boolean",
              "default": true
            },
            "token_ttl_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "broker",
            "issuer",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "device_auth_session"
            },
            "node_local": {
              "type": "boolean",
              "default": true
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "refresh_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "session_ref": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "session_ref",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "kind": {
              "type": "string",
              "const": "brokered_user_session"
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "broker",
            "provider"
          ]
        }
      ]
    },
    "McpServerRef": {
      "type": "object",
      "properties": {
        "allowed_tools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "$ref": "#/$defs/McpAuthRef"
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "transport",
        "uri",
        "auth"
      ]
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "ModelCandidate": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "model": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ModelRuntimeParameters"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "provider": {
          "$ref": "#/$defs/ModelProviderKind"
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "model",
        "priority",
        "weight"
      ]
    },
    "ModelFeature": {
      "type": "string",
      "enum": [
        "tool_use",
        "json_schema",
        "streaming",
        "vision",
        "long_context",
        "reasoning",
        "embeddings",
        "local_weights",
        "web_search"
      ]
    },
    "ModelLatencyClass": {
      "type": "string",
      "enum": [
        "fast",
        "balanced",
        "deep",
        "batch"
      ]
    },
    "ModelProviderKind": {
      "type": "string",
      "enum": [
        "codex",
        "open_ai",
        "open_ai_compatible",
        "bedrock",
        "vllm",
        "ollama",
        "llama_cpp",
        "anthropic",
        "hugging_face",
        "local_process",
        "other"
      ]
    },
    "ModelReasoningEffort": {
      "type": "string",
      "enum": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "ModelRuntimeParameters": {
      "type": "object",
      "properties": {
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "latency_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelLatencyClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "speed_tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature_milli": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "timeout_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "top_p_milli": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      }
    },
    "RunnerCapability": {
      "type": "string",
      "enum": [
        "code",
        "research",
        "web_search",
        "test",
        "review",
        "mcp_tools",
        "durable_child_tasks",
        "oidc_user_delegation",
        "local_commands",
        "git_cli",
        "docker_cli",
        "helm_cli",
        "kubernetes_cli",
        "build_tooling",
        "package_manager_cli",
        "workspace_sandbox",
        "container_sandbox",
        "gvisor_sandbox",
        "firecracker_sandbox",
        "kata_sandbox",
        "kubernetes_job_sandbox",
        "namespace_jail_sandbox",
        "provider_sandbox",
        "git_worktree",
        "git",
        "object_storage",
        "s3_compatible",
        "browser",
        "notifications",
        "local_models",
        "vllm",
        "open_ai_compatible",
        "gpu",
        "ephemeral_provisioning",
        "network_open",
        "formal_verification"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "UserPrincipalRef": {
      "type": "object",
      "properties": {
        "consent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "email_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "groups": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "issuer": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": "string"
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "issuer",
        "subject"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "claude_code",
        "staff_engineer_claude",
        "model_provider",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
