{
  "id": "ide-lsp-diagnostics",
  "kind": "ide_lsp",
  "enabled": true,
  "description": "IDE or editor LSP diagnostic changes emitted by a local extension, editor task, or developer workstation bridge.",
  "namespace": "coat",
  "webhook": null,
  "generic": {
    "auth": {
      "kind": "bearer_token",
      "secret_ref": {
        "provider": "env",
        "name": "COAT_IDE_SIGNAL_TOKEN",
        "key": null,
        "namespace": null,
        "audience": "coat-event-gateway"
      },
      "header_name": "authorization"
    },
    "accepts_cloudevents": true,
    "max_payload_bytes": 1048576,
    "allowed_event_types": [
      "ide.lsp.diagnostics.changed",
      "ide.lsp.workspace.diagnostics"
    ],
    "id_json_pointer": "/id",
    "type_json_pointer": "/type",
    "subject_json_pointer": "/subject",
    "dedupe_json_pointer": "/dedupe_key",
    "dedupe_header": "ce-id",
    "payload_schema": null,
    "mcp_context": null
  },
  "schedule": null,
  "calendar": null,
  "route": {
    "mode": "human_review",
    "goal_template": null,
    "target_goal_id": null,
    "steering_directive": null,
    "require_approval": true,
    "dedupe_window_seconds": 900
  }
}
