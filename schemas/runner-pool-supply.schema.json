      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "dispatchable_runners": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_concurrency": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "pending_provisions": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "pool_key": {
      "type": "string"
    },
    "registered_runners": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "running_tasks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "stale_runners": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
