{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KubernetesExecutorJobProvisionRequest",
  "type": "object",
  "properties": {
    "active_deadline_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "backoff_limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "field_manager": {
      "type": "string"
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "launch_plan": {
      "$ref": "#/$defs/SandboxLaunchPlan"
    },
    "mode": {
      "$ref": "#/$defs/KubernetesProvisionMode",
      "default": "plan_only"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "namespace": {
      "type": "string"
    },
    "runtime_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_account": {
      "type": [
        "string",
        "null"
      ]
    },
    "ttl_seconds_after_finished": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "workspace_mount_path": {
      "type": "string"
    },
    "workspace_pvc": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "launch_plan",
    "namespace",
    "workspace_mount_path",
    "field_manager",
    "backoff_limit"
  ],
  "$defs": {
    "GitResultRef": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "pushed": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "branch",
        "pushed"
      ]
    },
    "KubernetesProvisionMode": {
      "type": "string",
      "enum": [
        "plan_only",
        "server_dry_run",
        "apply"
      ]
    },
    "NetworkAccess": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "open"
      ]
    },
    "ObjectStorageArtifactRef": {
      "type": "object",
      "properties": {
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "store": {
          "$ref": "#/$defs/ObjectStoreRef"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "store",
        "key",
        "uri",
        "description"
      ]
    },
    "ObjectStoreKind": {
      "type": "string",
      "enum": [
        "aws_s3",
        "s3_compatible",
        "minio",
        "cloudflare_r2",
        "gcs_s3",
        "other"
      ]
    },
    "ObjectStoreRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "force_path_style": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ObjectStoreKind"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "bucket",
        "force_path_style"
      ]
    },
    "RunnerCapability": {
      "type": "string",
      "enum": [
        "code",
        "research",
        "web_search",
        "test",
        "review",
        "mcp_tools",
        "durable_child_tasks",
        "oidc_user_delegation",
        "local_commands",
        "git_cli",
        "docker_cli",
        "helm_cli",
        "kubernetes_cli",
        "build_tooling",
        "package_manager_cli",
        "workspace_sandbox",
        "container_sandbox",
        "gvisor_sandbox",
        "firecracker_sandbox",
        "kata_sandbox",
        "kubernetes_job_sandbox",
        "namespace_jail_sandbox",
        "provider_sandbox",
        "git_worktree",
        "git",
        "object_storage",
        "s3_compatible",
        "browser",
        "notifications",
        "local_models",
        "vllm",
        "open_ai_compatible",
        "gpu",
        "ephemeral_provisioning",
        "network_open",
        "formal_verification"
      ]
    },
    "SandboxBackend": {
      "type": "string",
      "enum": [
        "local_workspace",
        "container",
        "gvisor",
        "firecracker",
        "kata",
        "kubernetes_job",
        "namespace_jail",
        "provider_sandbox"
      ]
    },
    "SandboxLaunchPlan": {
      "type": "object",
      "properties": {
        "artifact_manifest_path": {
          "type": "string"
        },
        "backend": {
          "$ref": "#/$defs/SandboxBackend"
        },
        "checkpoint_manifest_path": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "git_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitResultRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_id": {
          "type": "string",
          "format": "uuid"
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "$ref": "#/$defs/SandboxNetworkPlan"
        },
        "object_prefix": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectStorageArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerCapability"
          }
        },
        "resources": {
          "$ref": "#/$defs/SandboxResourcePlan"
        },
        "runtime_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "security": {
          "$ref": "#/$defs/SandboxSecurityPlan"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "warnings": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_path": {
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "task_id",
        "workspace_id",
        "backend",
        "workspace_path",
        "artifact_manifest_path",
        "checkpoint_manifest_path",
        "resources",
        "security",
        "network"
      ]
    },
    "SandboxNetworkPlan": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "allowed_internal_services": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "deny_by_default": {
          "type": "boolean"
        },
        "egress_policy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingress_policy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "network_policy_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "access",
        "deny_by_default"
      ]
    },
    "SandboxResourcePlan": {
      "type": "object",
      "properties": {
        "cpu_limit_millis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "ephemeral_storage_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "memory_limit_mb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pids_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "SandboxSecurityPlan": {
      "type": "object",
      "properties": {
        "apparmor_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "drop_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "no_new_privileges": {
          "type": "boolean"
        },
        "read_only_rootfs": {
          "type": "boolean"
        },
        "run_as_non_root": {
          "type": "boolean"
        },
        "seccomp_profile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "read_only_rootfs",
        "no_new_privileges",
        "run_as_non_root"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    }
  }
}
