{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitResultPolicy",
  "type": "object",
  "properties": {
    "base_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch_prefix": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "include_patch_artifact": {
      "type": "boolean"
    },
    "push_on_success": {
      "type": "boolean"
    },
    "remote": {
      "type": [
        "string",
        "null"
      ]
    },
    "require_clean_diff": {
      "type": "boolean"
    },
    "worktree_root": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "enabled",
    "branch_prefix",
    "push_on_success",
    "require_clean_diff",
    "include_patch_artifact"
  ]
}
