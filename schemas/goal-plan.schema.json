{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalPlan",
  "type": "object",
  "properties": {
    "distribution_notes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "subgoals": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SubgoalSpec"
      }
    },
    "summary": {
      "type": "string",
      "default": ""
    }
  },
  "$defs": {
    "SubgoalSpec": {
      "type": "object",
      "properties": {
        "acceptance_evidence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "owner_role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "priority": {
          "$ref": "#/$defs/TaskPriority",
          "default": "normal"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "owner_role"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
