{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalRankingDecision",
  "type": "object",
  "properties": {
    "downvotes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "effective_priority": {
      "$ref": "#/$defs/TaskPriority"
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "hierarchy_role": {
      "$ref": "#/$defs/GoalHierarchyRole"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "$ref": "#/$defs/GoalRankingOutcome"
    },
    "reason": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "format": "int32"
    },
    "upvotes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "vote_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "goal_id",
    "score",
    "upvotes",
    "downvotes",
    "vote_count",
    "effective_priority",
    "hierarchy_role",
    "outcome",
    "reason"
  ],
  "$defs": {
    "GoalHierarchyRole": {
      "type": "string",
      "enum": [
        "overarching_goal",
        "peer_goal",
        "subgoal"
      ]
    },
    "GoalRankingOutcome": {
      "type": "string",
      "enum": [
        "pending",
        "promoted",
        "demoted",
        "unchanged"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ]
    }
  }
}
