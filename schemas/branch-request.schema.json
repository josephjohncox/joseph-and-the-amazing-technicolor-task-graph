{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchRequest",
  "type": "object",
  "properties": {
    "candidate_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "candidate_executions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ExecutionProfile"
      }
    },
    "candidate_roles": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkerKind"
      }
    },
    "goal_id": {
      "type": "string",
      "format": "uuid",
      "default": "00000000-0000-0000-0000-000000000000"
    },
    "operator": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_overrides": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "selection_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/BranchSelectionStrategy"
        },
        {
          "type": "null"
        }
      ]
    },
    "subgoal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "reason",
    "candidate_count"
  ],
  "$defs": {
    "AuthDistributionMode": {
      "type": "string",
      "enum": [
        "runner_local_only",
        "runner_resolves_refs",
        "coordinator_issues_lease",
        "workload_identity",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "AuthDistributionPolicy": {
      "type": "object",
      "properties": {
        "allow_node_local_device_session": {
          "type": "boolean"
        },
        "allow_secret_sync": {
          "type": "boolean"
        },
        "allowed_materials": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AuthMaterialKind"
          }
        },
        "lease_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/AuthDistributionMode"
        },
        "renewal": {
          "$ref": "#/$defs/AuthRenewalPolicy"
        },
        "require_human_approval_for_brokered_user_auth": {
          "type": "boolean"
        },
        "required_runner_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "mode",
        "renewal",
        "allow_node_local_device_session",
        "allow_secret_sync",
        "require_human_approval_for_brokered_user_auth"
      ]
    },
    "AuthMaterialKind": {
      "type": "string",
      "enum": [
        "api_token",
        "mcp_bearer_token",
        "oauth_access_token",
        "oauth_refresh_token",
        "oidc_id_token",
        "oidc_access_token",
        "oidc_refresh_token",
        "oidc_on_behalf_of_token",
        "device_auth_session",
        "workload_identity_token",
        "local_cli_session",
        "service_account",
        "other"
      ]
    },
    "AuthRenewalPolicy": {
      "type": "string",
      "enum": [
        "none",
        "manual_or_brokered",
        "broker_can_refresh",
        "runner_can_refresh"
      ]
    },
    "BranchSelectionStrategy": {
      "type": "string",
      "enum": [
        "human",
        "voter_quorum",
        "highest_score",
        "unifier_decision"
      ]
    },
    "CapacityProvisionerBackend": {
      "type": "string",
      "enum": [
        "kubernetes_controller",
        "kubernetes_api",
        "external_provisioner",
        "manual_manifest"
      ]
    },
    "CapacityProvisionerPolicy": {
      "type": "object",
      "properties": {
        "allow_manual_manifest_escape_hatch": {
          "type": "boolean"
        },
        "backend": {
          "$ref": "#/$defs/CapacityProvisionerBackend"
        },
        "controller_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_manager": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_account": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "backend",
        "field_manager",
        "allow_manual_manifest_escape_hatch"
      ]
    },
    "CapacityProvisioningMode": {
      "type": "string",
      "enum": [
        "registered_runners_only",
        "prefer_registered_then_ephemeral",
        "ephemeral_only"
      ]
    },
    "CapacityProvisioningPolicy": {
      "description": "Task-local policy for adding execution capacity.\n\nThe coordinator or executor framework interprets this policy. Operators\nshould not hand-create one-off Kubernetes Jobs for every task; instead, task\nexecution can reference approved templates that provision bounded runner or\nservice-executor capacity and then register through the normal runner\nregistry or Restate deployment path.",
      "type": "object",
      "properties": {
        "max_pending_provisions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/CapacityProvisioningMode"
        },
        "provisioner": {
          "$ref": "#/$defs/CapacityProvisionerPolicy",
          "default": {
            "allow_manual_manifest_escape_hatch": true,
            "backend": "kubernetes_controller",
            "controller_ref": "coat-kubernetes-provisioner",
            "field_manager": "coat-kubernetes-provisioner",
            "namespace": "jattg-ephemeral",
            "service_account": "jattg-ephemeral-runner"
          }
        },
        "request_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "require_human_approval": {
          "type": "boolean"
        },
        "scaling": {
          "$ref": "#/$defs/CapacityScalingPolicy",
          "default": {
            "cooldown_seconds": 300,
            "enabled": false,
            "event_weight": 1,
            "headroom_runners": 0,
            "max_runners": 8,
            "max_scale_down_step": 1,
            "max_scale_up_step": 2,
            "min_runners": 0,
            "mode": "recommend_only",
            "scale_from_events": true,
            "slots_per_runner": 1,
            "target_backlog_per_runner": 2,
            "target_utilization_percent": 75
          }
        },
        "template_refs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EphemeralRunnerTemplateRef"
          }
        }
      },
      "required": [
        "mode",
        "request_timeout_seconds",
        "max_pending_provisions",
        "require_human_approval"
      ]
    },
    "CapacityScalingMode": {
      "type": "string",
      "enum": [
        "manual",
        "recommend_only",
        "provision_ephemeral"
      ]
    },
    "CapacityScalingPolicy": {
      "description": "Bounded policy for dynamically adding or retiring runner capacity.\n\nThe coordinator computes durable demand from runnable tasks, events, and\nqueue processors. A provisioner may realize the resulting recommendations,\nbut only within these limits and the surrounding approval policy.",
      "type": "object",
      "properties": {
        "cooldown_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "event_weight": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "headroom_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "max_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 8,
          "minimum": 0
        },
        "max_scale_down_step": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "max_scale_up_step": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "min_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/CapacityScalingMode",
          "default": "recommend_only"
        },
        "scale_from_events": {
          "type": "boolean",
          "default": true
        },
        "slots_per_runner": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "target_backlog_per_runner": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "target_utilization_percent": {
          "type": "integer",
          "format": "uint32",
          "default": 75,
          "minimum": 0
        }
      }
    },
    "CheckpointMode": {
      "type": "string",
      "enum": [
        "disabled",
        "on_result",
        "periodic",
        "manual_only"
      ]
    },
    "CheckpointPolicy": {
      "description": "Task-local checkpoint policy for reviewable worker history.\n\nCheckpoints are durable references, not large inline state. A worker may\ncreate git commits/tags, workspace snapshots, object-store archives, or\nmetadata-only checkpoints and return them in `AgentRunResult.checkpoints`.",
      "type": "object",
      "properties": {
        "branch_prefix": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "git_checkpoint_on_result": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/CheckpointMode"
        },
        "object_checkpoint_on_result": {
          "type": "boolean"
        },
        "require_for_code_changes": {
          "type": "boolean"
        },
        "tag_prefix": {
          "type": "string"
        },
        "workspace_snapshot_on_result": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "mode",
        "git_checkpoint_on_result",
        "workspace_snapshot_on_result",
        "object_checkpoint_on_result",
        "require_for_code_changes",
        "branch_prefix",
        "tag_prefix"
      ]
    },
    "ChildTaskRequestChannel": {
      "type": "string",
      "enum": [
        "agent_run_result_child_requests"
      ]
    },
    "DeviceAuthProvider": {
      "type": "string",
      "enum": [
        "codex",
        "claude_code",
        "open_ai",
        "anthropic",
        "github",
        "google",
        "other"
      ]
    },
    "EphemeralCapacityKind": {
      "type": "string",
      "enum": [
        "runner_job",
        "restate_service_executor",
        "sandbox_job"
      ]
    },
    "EphemeralRunnerTemplateRef": {
      "type": "object",
      "properties": {
        "active_deadline_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "config_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/EphemeralCapacityKind"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "name": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerCapability"
          }
        },
        "ttl_seconds_after_finished": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "kind"
      ]
    },
    "ExecutionProfile": {
      "description": "Task-local runner, model, persona, MCP, notification, result, and guardrail policy.\n\nThis is the contract that lets distributed runners and model providers pick\nup work without reading global plan prose. It is documented in\n`docs/design-docs/010-distributed-runners-mcp.md`.",
      "type": "object",
      "properties": {
        "capacity": {
          "$ref": "#/$defs/CapacityProvisioningPolicy",
          "default": {
            "max_pending_provisions": 1,
            "mode": "registered_runners_only",
            "provisioner": {
              "allow_manual_manifest_escape_hatch": true,
              "backend": "kubernetes_controller",
              "controller_ref": "coat-kubernetes-provisioner",
              "field_manager": "coat-kubernetes-provisioner",
              "namespace": "jattg-ephemeral",
              "service_account": "jattg-ephemeral-runner"
            },
            "request_timeout_seconds": 600,
            "require_human_approval": true,
            "scaling": {
              "cooldown_seconds": 300,
              "enabled": false,
              "event_weight": 1,
              "headroom_runners": 0,
              "max_runners": 8,
              "max_scale_down_step": 1,
              "max_scale_up_step": 2,
              "min_runners": 0,
              "mode": "recommend_only",
              "scale_from_events": true,
              "slots_per_runner": 1,
              "target_backlog_per_runner": 2,
              "target_utilization_percent": 75
            },
            "template_refs": []
          }
        },
        "guardrails": {
          "$ref": "#/$defs/ExecutorGuardrailPolicy",
          "default": {
            "block_on_high_findings": true,
            "enabled": false,
            "max_inline_output_bytes": 65536,
            "output_reviewer_role": "reviewer",
            "redact_secrets": true,
            "require_artifact_manifest": false,
            "require_output_review": false,
            "require_sandbox_attestation": false,
            "require_security_review": false,
            "require_strong_sandbox_attestation": false,
            "security_reviewer_role": "validator"
          }
        },
        "local_tools": {
          "$ref": "#/$defs/LocalToolPolicy",
          "default": {
            "allowed_tools": [],
            "approval": "risk_based",
            "default_timeout_seconds": 600,
            "denied_binaries": [],
            "enabled": false,
            "max_output_bytes": 65536,
            "require_command_evidence": true,
            "require_sandbox_runner": true,
            "require_workspace": true
          }
        },
        "mcp": {
          "$ref": "#/$defs/McpContextRef"
        },
        "model": {
          "$ref": "#/$defs/ModelRoute"
        },
        "notifications": {
          "$ref": "#/$defs/NotificationPolicy"
        },
        "persona": {
          "$ref": "#/$defs/PersonaSpec"
        },
        "results": {
          "$ref": "#/$defs/ResultChannelPolicy",
          "default": {
            "checkpoints": {
              "branch_prefix": "jattg/checkpoint",
              "enabled": true,
              "git_checkpoint_on_result": true,
              "mode": "on_result",
              "object_checkpoint_on_result": true,
              "require_for_code_changes": false,
              "tag_prefix": "jattg-checkpoint",
              "workspace_snapshot_on_result": true
            },
            "git": {
              "base_ref": "HEAD",
              "branch_prefix": "jattg/task",
              "enabled": false,
              "include_patch_artifact": true,
              "push_on_success": false,
              "remote": "origin",
              "require_clean_diff": true,
              "worktree_root": "/worktrees"
            },
            "object_storage": {
              "enabled": false,
              "key_prefix_template": "goals/{goal_id}/tasks/{task_id}",
              "max_inline_bytes": 262144,
              "require_manifest": true,
              "store": null
            }
          }
        },
        "runner": {
          "$ref": "#/$defs/RunnerSelector"
        },
        "subagents": {
          "$ref": "#/$defs/SubagentDelegationPolicy",
          "default": {
            "child_request_channel": "agent_run_result_child_requests",
            "inject_runner_context": true,
            "mode": "coordinator_durable_tasks",
            "native_spawn": "disabled"
          }
        }
      },
      "required": [
        "runner",
        "model",
        "persona",
        "mcp",
        "notifications"
      ]
    },
    "ExecutorGuardrailPolicy": {
      "type": "object",
      "properties": {
        "block_on_high_findings": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_inline_output_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_reviewer_role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "redact_secrets": {
          "type": "boolean"
        },
        "require_artifact_manifest": {
          "type": "boolean"
        },
        "require_output_review": {
          "type": "boolean"
        },
        "require_sandbox_attestation": {
          "type": "boolean"
        },
        "require_security_review": {
          "type": "boolean"
        },
        "require_strong_sandbox_attestation": {
          "type": "boolean"
        },
        "security_reviewer_role": {
          "$ref": "#/$defs/WorkerKind"
        }
      },
      "required": [
        "enabled",
        "require_output_review",
        "require_security_review",
        "output_reviewer_role",
        "security_reviewer_role",
        "block_on_high_findings",
        "require_artifact_manifest",
        "require_sandbox_attestation",
        "require_strong_sandbox_attestation",
        "redact_secrets",
        "max_inline_output_bytes"
      ]
    },
    "GitResultPolicy": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_prefix": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "include_patch_artifact": {
          "type": "boolean"
        },
        "push_on_success": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_clean_diff": {
          "type": "boolean"
        },
        "worktree_root": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled",
        "branch_prefix",
        "push_on_success",
        "require_clean_diff",
        "include_patch_artifact"
      ]
    },
    "LocalToolApprovalMode": {
      "type": "string",
      "enum": [
        "inherit",
        "risk_based",
        "always",
        "never"
      ]
    },
    "LocalToolCategory": {
      "type": "string",
      "enum": [
        "version_control",
        "container_runtime",
        "kubernetes",
        "helm",
        "package_manager",
        "build_tool",
        "test_runner",
        "formal_methods",
        "shell",
        "system",
        "other"
      ]
    },
    "LocalToolPermission": {
      "type": "object",
      "properties": {
        "allowed_subcommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "binary": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/LocalToolCategory"
        },
        "denied_args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "required_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerCapability"
          }
        },
        "required_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "requires_cluster_access": {
          "type": "boolean",
          "default": false
        },
        "requires_docker_socket": {
          "type": "boolean",
          "default": false
        },
        "requires_network": {
          "type": "boolean",
          "default": false
        },
        "risk": {
          "$ref": "#/$defs/LocalToolRisk"
        },
        "timeout_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "binary",
        "category",
        "risk"
      ]
    },
    "LocalToolPolicy": {
      "description": "Task-local allowlist for running local binaries in an isolated workspace.\n\nThis does not grant ambient shell access. It declares which binaries a\nrunner or sandbox executor may invoke, which runner capabilities must be\npresent, how approval is handled, and what evidence must be returned.",
      "type": "object",
      "properties": {
        "allowed_tools": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/LocalToolPermission"
          }
        },
        "approval": {
          "$ref": "#/$defs/LocalToolApprovalMode",
          "default": "risk_based"
        },
        "default_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "denied_binaries": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "max_output_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "require_command_evidence": {
          "type": "boolean",
          "default": true
        },
        "require_sandbox_runner": {
          "type": "boolean",
          "default": true
        },
        "require_workspace": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "enabled",
        "default_timeout_seconds",
        "max_output_bytes"
      ]
    },
    "LocalToolRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "McpAccessMode": {
      "type": "string",
      "enum": [
        "single_user",
        "multi_user_oidc"
      ]
    },
    "McpAuthRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secret"
            },
            "secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "workload_identity"
            }
          },
          "required": [
            "kind",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oauth_delegation"
            },
            "token_exchange_secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "token_exchange_secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
