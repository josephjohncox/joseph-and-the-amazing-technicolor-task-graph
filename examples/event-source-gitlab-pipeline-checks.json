{
  "id": "gitlab-pipeline-checks",
  "kind": "gitlab_pipeline_check",
  "enabled": true,
  "description": "GitLab pipeline, merge-request pipeline, and job status events normalized into pull-request check activity.",
  "namespace": "coat",
  "webhook": null,
  "generic": {
    "auth": {
      "kind": "bearer_token",
      "secret_ref": {
        "provider": "env",
        "name": "COAT_GITLAB_PIPELINE_SIGNAL_TOKEN",
        "key": null,
        "namespace": null,
        "audience": "coat-event-gateway"
      },
      "header_name": "authorization"
    },
    "accepts_cloudevents": true,
    "max_payload_bytes": 1048576,
    "allowed_event_types": [
      "gitlab.pipeline.failed",
      "gitlab.pipeline.completed",
      "gitlab.job.failed"
    ],
    "id_json_pointer": "/object_attributes/id",
    "type_json_pointer": "/type",
    "subject_json_pointer": "/subject",
    "dedupe_json_pointer": "/delivery_id",
    "dedupe_header": "x-gitlab-event-uuid",
    "payload_schema": null,
    "mcp_context": null
  },
  "sqs": null,
  "schedule": null,
  "calendar": null,
  "route": {
    "mode": "create_goal",
    "goal_template": {
      "title_template": "Fix GitLab pipeline failure for {{subject}}",
      "objective_template": "Investigate GitLab pipeline event {{event_id}} for {{subject}}. Read payload._coat_change_activity for project, branch, merge request, pipeline ID, commit SHA, status, conclusion, and pipeline URL. Search durable memory for recurrence before proposing or applying a bounded fix with validation evidence.",
      "repo": "example/repo",
      "worker_role": "tester",
      "tags": [
        "gitlab",
        "merge-request",
        "pipeline",
        "test-failure"
      ]
    },
    "target_goal_id": null,
    "steering_directive": null,
    "require_approval": false,
    "dedupe_window_seconds": 3600
  }
}
