{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultChannelPolicy",
  "type": "object",
  "properties": {
    "checkpoints": {
      "$ref": "#/$defs/CheckpointPolicy",
      "default": {
        "branch_prefix": "coat/checkpoint",
        "enabled": true,
        "git_checkpoint_on_result": true,
        "mode": "on_result",
        "object_checkpoint_on_result": true,
        "require_for_code_changes": false,
        "tag_prefix": "coat-checkpoint",
        "workspace_snapshot_on_result": true
      }
    },
    "git": {
      "$ref": "#/$defs/GitResultPolicy",
      "default": {
        "base_ref": "HEAD",
        "branch_prefix": "coat/task",
        "enabled": false,
        "include_patch_artifact": true,
        "push_on_success": false,
        "remote": "origin",
        "require_clean_diff": true,
        "worktree_root": "/worktrees"
      }
    },
    "object_storage": {
      "$ref": "#/$defs/ObjectStoragePolicy",
      "default": {
        "enabled": false,
        "key_prefix_template": "goals/{goal_id}/tasks/{task_id}",
        "max_inline_bytes": 262144,
        "require_manifest": true,
        "store": null
      }
    }
  },
  "$defs": {
    "CheckpointMode": {
      "type": "string",
      "enum": [
        "disabled",
        "on_result",
        "periodic",
        "manual_only"
      ]
    },
    "CheckpointPolicy": {
      "description": "Task-local checkpoint policy for reviewable worker history.\n\nCheckpoints are durable references, not large inline state. A worker may\ncreate git commits/tags, workspace snapshots, object-store archives, or\nmetadata-only checkpoints and return them in `AgentRunResult.checkpoints`.",
      "type": "object",
      "properties": {
        "branch_prefix": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "git_checkpoint_on_result": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/CheckpointMode"
        },
        "object_checkpoint_on_result": {
          "type": "boolean"
        },
        "require_for_code_changes": {
          "type": "boolean"
        },
        "tag_prefix": {
          "type": "string"
        },
        "workspace_snapshot_on_result": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "mode",
        "git_checkpoint_on_result",
        "workspace_snapshot_on_result",
        "object_checkpoint_on_result",
        "require_for_code_changes",
        "branch_prefix",
        "tag_prefix"
      ]
    },
    "GitResultPolicy": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_prefix": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "include_patch_artifact": {
          "type": "boolean"
        },
        "push_on_success": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_clean_diff": {
          "type": "boolean"
        },
        "worktree_root": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled",
        "branch_prefix",
        "push_on_success",
        "require_clean_diff",
        "include_patch_artifact"
      ]
    },
    "ObjectStoragePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "key_prefix_template": {
          "type": "string"
        },
        "max_inline_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "require_manifest": {
          "type": "boolean"
        },
        "store": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectStoreRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "key_prefix_template",
        "require_manifest",
        "max_inline_bytes"
      ]
    },
    "ObjectStoreKind": {
      "type": "string",
      "enum": [
        "aws_s3",
        "s3_compatible",
        "minio",
        "cloudflare_r2",
        "gcs_s3",
        "other"
      ]
    },
    "ObjectStoreRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "force_path_style": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ObjectStoreKind"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "bucket",
        "force_path_style"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    }
  }
}
