# Copy to .envrc.local for machine-local secrets and provider setup.
# .envrc.local is gitignored. Run `direnv allow` after editing.
#
# Keep service endpoints, data paths, cloud defaults, and deployment profiles in
# `.coat/project.json` or `~/.coat/config.json`. This file is only for secrets,
# opt-in dotenv loading, and rare machine-local overrides.

# Load local provider env generated by `coat setup local-auth`.
# dotenv_if_exists infra/compose/local-providers.env

# Load Restate Cloud env only on machines that should hold those credentials.
# dotenv_if_exists infra/compose/restate-cloud.env

# Optional non-default user config file. Prefer `coat --config-profile ...` for
# one-off profile selection.
# export COAT_CONFIG="$HOME/.coat/config.json"

# Optional local debugging knobs.
# export COAT_BUILD_PROFILE=debug
# export COAT_BUILD_PROFILE=release
# export RUST_LOG=info
# export RUST_BACKTRACE=1

# Optional secrets and interactive chat-client tokens.
# export COAT_CONTROL_GATEWAY_TOKEN=
# export COAT_CONTROL_MCP_TOKEN=
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
# export CLAUDE_CODE_OAUTH_TOKEN=
