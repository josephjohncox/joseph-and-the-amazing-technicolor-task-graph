{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunnerScalingDecision",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/CapacityScalingMode"
    },
    "pool_decisions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RunnerPoolScalingDecision"
      }
    },
    "reasons": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "status": {
      "$ref": "#/$defs/RunnerScalingStatus"
    }
  },
  "required": [
    "status",
    "mode"
  ],
  "$defs": {
    "CapacityScalingMode": {
      "type": "string",
      "enum": [
        "manual",
        "recommend_only",
        "provision_ephemeral"
      ]
    },
    "RunnerPoolScalingDecision": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/RunnerScalingAction"
        },
        "current_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "current_slots": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "demand_units": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "desired_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "desired_slots": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "event_backlog": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pool_key": {
          "type": "string"
        },
        "provision_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "queue_depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "retire_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "pool_key",
        "action",
        "desired_runners",
        "current_runners",
        "desired_slots",
        "current_slots",
        "provision_runners",
        "retire_runners",
        "demand_units",
        "queue_depth",
        "event_backlog"
      ]
    },
    "RunnerScalingAction": {
      "type": "string",
      "enum": [
        "scale_up",
        "scale_down",
        "steady"
      ]
    },
    "RunnerScalingStatus": {
      "type": "string",
      "enum": [
        "noop",
        "steady",
        "provision_recommended",
        "retirement_recommended"
      ]
    }
  }
}
