  "schema_version": "scenario-spec/v1",
  "id": "operator_usability_workbench",
  "title": "Operator usability workbench",
  "description": "Exercise the plan-first operator path: ask without creating a draft, draft and accept a plan, draft/edit/discard/accept a goal inside that plan, submit it, resolve human actions, see worker runs and evidence, and complete with a selected goal projection.",
  "determinism": {
    "mode": "stub_projection_replay",
    "projection_mode": "fixture_replay",
    "clock_start": "2026-05-14T12:00:00Z",
    "seed": 4201,
    "live_provider_credentials_required": false,
    "network_required": false,
    "stub_runner_id": "scenario-stub-runner"
  },
  "goals": [
    {
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "creation": "chat_draft_accepted",
      "spec": {
        "id": "00000000-0000-4000-8000-000000004201",
        "title": "Simplify operator usability",
        "objective": "Prove the SPA and TUI can guide an operator from chat ask to accepted goal and explicit action resolution without raw JSON.",
        "initial_tasks": [
          {
            "role": "planner",
            "title": "Resolve operator usability workbench",
            "prompt": "Return deterministic worker and evidence output for the simplified operator flow.",
            "reason": "Exercise draft, action queue, worker-run, evidence, and selected-goal projections.",
            "tags": ["scenario", "operator", "usability"]
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "ask_workspace_default",
      "type": "emit_external_event",
      "description": "Ask is the default chat mode and must not create a goal draft.",
      "event": {
        "event_type": "operator.chat.ask",
        "session_id": "operator:default",
        "kind": "ask",
        "mode": "ask",
        "selected_goal_id": null,
        "message": "What is blocked and what should I do next?"
      },
      "expect": {
        "chat_response_kind": "answer",
        "draft_created": false,
        "draft_visible": false
      }
    },
    {
      "id": "draft_plan",
      "type": "emit_external_event",
      "description": "The operator explicitly drafts a plan before goal drafting.",
      "event": {
        "event_type": "operator.plan.draft.created",
        "plan_id": "00000000-0000-4000-8000-000000004200",
        "plan_phase": "drafting_plan",
        "kind": "plan",
        "mode": "draft_plan",
        "draft_ref": "fixture://plans/operator-usability-workbench",
        "title": "Operator usability plan",
        "allowed_actions": ["edit_plan", "add_goal_slot", "accept_plan_draft", "discard_draft"]
      },
      "expect": {
        "plan_draft_created": true,
        "plan_phase": "drafting_plan",
        "phase_action": "accept_plan_draft"
      }
    },
    {
      "id": "accept_plan_draft",
      "type": "emit_external_event",
      "description": "The operator accepts the plan draft before creating goal drafts.",
      "event": {
        "event_type": "operator.plan.draft.accepted",
        "plan_id": "00000000-0000-4000-8000-000000004200",
        "plan_phase": "accepting",
        "draft_ref": "fixture://plans/operator-usability-workbench",
        "allowed_actions": ["draft_goal", "hold_for_later"]
      },
      "expect": {
        "plan_draft_visible": false,
        "plan_phase": "drafting_goals",
        "phase_action": "draft_goal"
      }
    },
    {
      "id": "draft_goal",
      "type": "emit_external_event",
      "description": "The operator explicitly switches to Draft goal after accepting the plan draft.",
      "event": {
        "event_type": "operator.goal.draft.created",
        "plan_id": "00000000-0000-4000-8000-000000004200",
        "plan_phase": "drafting_goals",
        "kind": "goal",
        "mode": "draft_goal",
        "draft_ref": "fixture://drafts/operator-usability-workbench",
        "title": "Simplify operator usability"
      },
      "expect": {
        "draft_created": true,
        "draft_visible": true
      }
    },
    {
      "id": "discard_draft",
      "type": "emit_external_event",
      "description": "A draft can be discarded without changing the selected goal.",
      "event": {
        "event_type": "operator.draft.discarded",
        "plan_id": "00000000-0000-4000-8000-000000004200",
        "draft_ref": "fixture://drafts/operator-usability-workbench"
      },
      "expect": {
        "draft_visible": false,
        "selected_goal_unchanged": true
      }
    },
    {
      "id": "draft_goal_again",
      "type": "emit_external_event",
      "description": "The operator drafts a replacement goal and reviews it.",
      "event": {
        "event_type": "operator.goal.draft.created",
        "plan_id": "00000000-0000-4000-8000-000000004200",
        "plan_phase": "drafting_goals",
        "kind": "goal",
        "mode": "draft_goal",
        "draft_ref": "fixture://drafts/operator-usability-workbench-v2",
        "title": "Simplify operator usability"
      },
      "expect": {
        "draft_created": true,
        "draft_visible": true
      }
    },
    {
      "id": "accept_draft",
      "type": "emit_external_event",
      "description": "The operator accepts the reviewed draft before submit.",
      "event": {
        "event_type": "operator.draft.accepted",
        "plan_id": "00000000-0000-4000-8000-000000004200",
        "plan_phase": "accepting",
        "draft_ref": "fixture://drafts/operator-usability-workbench-v2",
        "accepted_goal_id": "00000000-0000-4000-8000-000000004201"
      },
      "expect": {
        "draft_visible": false,
        "selected_goal_id": "00000000-0000-4000-8000-000000004201"
      }
    },
    {
      "id": "submit_goal",
      "type": "submit_goal",
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "description": "Submit the accepted draft as a coordinator-owned goal.",
      "expect": {
        "goal_status": "running"
      }
    },
    {
      "id": "request_human_action",
      "type": "inject_worker_result",
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "description": "Replay a worker result that creates explicit action cards for a thunk and approval.",
      "worker_result": {
        "task_id": "00000000-0000-4000-8000-000000004211",
        "status": "waiting_approval",
        "summary": "Waiting for the operator to approve the deterministic fixture and provide context.",
        "confidence": 0.92,
        "runner_id": "scenario-stub-runner",
        "operator_action": "Approve the fixture gate, add context if useful, or replan/cancel the goal.",
        "recovery_actions": ["approve", "continue", "add-context", "replan", "cancel"],
        "delayed_compute_thunks": [
          {
            "thunk_id": "00000000-0000-4000-8000-000000004221",
            "kind": "human_input",
            "status": "pending",
            "summary": "Choose whether to continue the usability fixture.",
            "wait_ref": "wait://operator_usability_workbench/human-input",
            "continuation_ref": "continuation://operator_usability_workbench/human-input",
            "operator_action": "Choose Continue, answer with context, replan, or cancel.",
            "human_prompt": {
              "title": "Continue usability fixture?",
              "question": "Should the deterministic usability fixture continue?",
              "why_waiting": "The worker produced a durable human prompt.",
              "allowed_actions": ["continue", "answer", "add-context", "replan", "cancel"],
              "required_context": "optional",
              "continuation_ref": "continuation://operator_usability_workbench/human-input"
            }
          },
          {
            "thunk_id": "00000000-0000-4000-8000-000000004222",
            "kind": "approval",
            "status": "pending",
            "summary": "Approve the fixture gate.",
            "approval_ref": "approval://operator_usability_workbench/fixture-gate",
            "continuation_ref": "continuation://operator_usability_workbench/approval",
            "operator_action": "Approve or reject the fixture gate.",
            "approval_request": {
              "title": "Approve fixture gate",
              "question": "Approve this deterministic gate and continue?",
              "allowed_actions": ["approve", "reject", "replan"],
              "approval_ref": "approval://operator_usability_workbench/fixture-gate",
              "continuation_ref": "continuation://operator_usability_workbench/approval"
            }
          }
        ]
      }
    },
    {
      "id": "approve_gate",
      "type": "resume_delayed_compute",
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "after": ["request_human_action"],
      "resume": {
        "thunk_id": "00000000-0000-4000-8000-000000004222",
        "approval_ref": "approval://operator_usability_workbench/fixture-gate",
        "continuation_ref": "continuation://operator_usability_workbench/approval",
        "action": "approve",
        "operator_action": "Approve the fixture gate and continue."
      }
    },
    {
      "id": "resume_with_context",
      "type": "resume_delayed_compute",
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "after": ["approve_gate"],
      "resume": {
        "thunk_id": "00000000-0000-4000-8000-000000004221",
        "continuation_ref": "continuation://operator_usability_workbench/human-input",
        "action": "add-context",
        "response_summary": "Proceed with the simplified operator path.",
        "operator_action": "Resume the human prompt with operator context."
      }
    },
    {
      "id": "complete_worker_run",
      "type": "inject_worker_result",
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "task_id": "00000000-0000-4000-8000-000000004211",
      "after": ["resume_with_context"],
      "worker_result": {
        "task_id": "00000000-0000-4000-8000-000000004211",
        "status": "done",
        "summary": "Operator usability fixture completed after explicit action resolution.",
        "confidence": 0.96,
        "runner_id": "scenario-stub-runner",
        "artifacts": [
          {
            "kind": "report",
            "uri": "artifact://scenarios/operator_usability_workbench/usability-report.json",
            "description": "Ask/draft/action/evidence operator flow report"
