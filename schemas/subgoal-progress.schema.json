{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubgoalProgress",
  "type": "object",
  "properties": {
    "color": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphColorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "open_tasks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "owner_role": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "runnable_tasks": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "status": {
      "$ref": "#/$defs/SubgoalStatus"
    },
    "subgoal_id": {
      "type": "string"
    },
    "terminal_ok_tasks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_tasks": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "subgoal_id",
    "status",
    "total_tasks",
    "open_tasks",
    "terminal_ok_tasks"
  ],
  "$defs": {
    "GraphColorRef": {
      "description": "Stable visual metadata for the Technicolor Task Graph.\n\nColors are semantic graph state, not dashboard decoration. They let\noperators, reviewers, dashboards, and MCP clients preserve a consistent\nlegend across task projections, branches, reviews, and subgoals.",
      "type": "object",
      "properties": {
        "hex": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "hex",
        "meaning"
      ]
    },
    "SubgoalStatus": {
      "type": "string",
      "enum": [
        "planned",
        "open",
        "running",
        "done",
        "blocked",
        "failed"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "claude_code",
        "staff_engineer_claude",
        "model_provider",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
