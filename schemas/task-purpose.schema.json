{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPurpose",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "work"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "review"
        },
        "round": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "subject_id",
        "round"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "unification"
        },
        "round": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "kind",
        "subject_ids",
        "round"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "actor_retry"
        },
        "round": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "subject_id",
        "round"
      ]
    },
    {
      "type": "object",
      "properties": {
        "candidate_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "group_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "candidate_branch"
        },
        "original_task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "group_id",
        "original_task_id",
        "candidate_index"
      ]
    },
    {
      "type": "object",
      "properties": {
        "candidate_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "group_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "branch_vote"
        }
      },
      "required": [
        "kind",
        "group_id",
        "candidate_task_ids"
      ]
    },
    {
      "type": "object",
      "properties": {
        "candidate_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "group_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "branch_unification"
        },
        "voter_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "kind",
        "group_id",
        "candidate_task_ids",
        "voter_task_ids"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "research"
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "question"
      ]
    }
  ]
}
