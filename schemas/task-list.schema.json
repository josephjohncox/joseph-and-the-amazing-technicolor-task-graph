{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskList",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "progress": {
      "$ref": "#/$defs/GoalProgress"
    },
    "query": {
      "$ref": "#/$defs/TaskQuery"
    },
    "tasks": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskProgress"
      }
    }
  },
  "required": [
    "goal_id",
    "query",
    "progress"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "patch",
        "test_result",
        "report",
        "pull_request",
        "workspace_snapshot",
        "git_branch",
        "git_commit",
        "git_worktree",
        "object_storage_object",
        "object_storage_prefix",
        "artifact_manifest",
        "schema",
        "other"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "description"
      ]
    },
    "GoalProgress": {
      "type": "object",
      "properties": {
        "blocked_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "by_status": {
          "type": "object",
          "properties": {
            "blocked": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "cancelled": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "done": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "needs_validation": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "pending": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "runnable": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "running": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "waiting_approval": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "failed_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "goal_id": {
          "type": "string",
          "format": "uuid"
        },
        "next_tasks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskProgress"
          }
        },
        "open_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "percent_done": {
          "type": "number",
          "format": "float"
        },
        "runnable_tasks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "satisfaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/SatisfactionReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/GoalStatus"
        },
        "subgoals": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SubgoalProgress"
          }
        },
        "terminal_ok_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "total_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waiting_approval_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "goal_id",
        "title",
        "status",
        "total_tasks",
        "open_tasks",
        "terminal_ok_tasks",
        "blocked_tasks",
        "failed_tasks",
        "waiting_approval_tasks",
        "percent_done"
      ]
    },
    "GoalStatus": {
      "type": "string",
      "enum": [
        "running",
        "waiting_approval",
        "done",
        "blocked",
        "failed",
        "paused",
        "cancelled"
      ]
    },
    "ReviewDecision": {
      "type": "string",
      "enum": [
        "accept",
        "changes_requested",
        "blocked",
        "inconclusive"
      ]
    },
    "SatisfactionReport": {
      "type": "object",
      "properties": {
        "all_tasks_terminal": {
          "type": "boolean"
        },
        "latest_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "open_findings": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "open_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "reviews_passed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reviews_required": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "satisfied": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "format": "float"
        },
        "unification_done": {
          "type": "boolean"
        },
        "work_done": {
          "type": "boolean"
        }
      },
      "required": [
        "satisfied",
        "score",
        "work_done",
        "reviews_required",
        "reviews_passed",
        "unification_done",
        "all_tasks_terminal",
        "open_tasks",
        "open_findings"
      ]
    },
    "SubgoalProgress": {
      "type": "object",
      "properties": {
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "open_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "owner_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkerKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "runnable_tasks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "status": {
          "$ref": "#/$defs/SubgoalStatus"
        },
        "subgoal_id": {
          "type": "string"
        },
        "terminal_ok_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "subgoal_id",
        "status",
        "total_tasks",
        "open_tasks",
        "terminal_ok_tasks"
      ]
    },
    "SubgoalStatus": {
      "type": "string",
      "enum": [
        "planned",
        "open",
        "running",
        "done",
        "blocked",
        "failed"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ]
    },
    "TaskProgress": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "blocked_by": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "child_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "dependency_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "priority": {
          "$ref": "#/$defs/TaskPriority"
        },
        "purpose_kind": {
          "$ref": "#/$defs/TaskPurposeKind"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "runnable": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "subgoal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "title",
        "status",
        "role",
        "purpose_kind",
        "depth",
        "priority",
        "attempts",
        "dependency_count",
        "child_count",
        "runnable"
      ]
    },
    "TaskPurposeKind": {
      "type": "string",
      "enum": [
        "work",
        "review",
        "unification",
        "actor_retry",
        "candidate_branch",
        "branch_vote",
        "branch_unification",
        "research"
      ]
    },
    "TaskQuery": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "purpose_kinds": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskPurposeKind"
          }
        },
        "roles": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkerKind"
          }
        },
        "runnable_only": {
          "type": "boolean",
          "default": false
        },
        "statuses": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TaskStatus"
          }
        },
        "subgoal_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "pending",
        "runnable",
        "running",
        "needs_validation",
        "waiting_approval",
        "done",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
