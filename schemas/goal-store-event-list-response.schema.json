{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalStoreEventListResponse",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/GoalEventRecord"
      }
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "goal_id"
  ],
  "$defs": {
    "GoalEventKind": {
      "type": "string",
      "enum": [
        "submitted",
        "state_projected",
        "task_started",
        "task_completed",
        "task_blocked",
        "approval_requested",
        "approval_decided",
        "steering_applied",
        "validation_recorded",
        "artifact_recorded",
        "cancelled",
        "failed",
        "other"
      ]
    },
    "GoalEventRecord": {
      "type": "object",
      "properties": {
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "goal_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GoalEventKind"
        },
        "message": {
          "type": "string"
        },
        "payload_json": {
          "default": null
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "event_id",
        "goal_id",
        "sequence",
        "kind",
        "message",
        "idempotency_key"
      ]
    }
  }
}
