{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewDoctrine",
  "type": "object",
  "properties": {
    "coverage": {
      "$ref": "#/$defs/ReviewDoctrineCoveragePolicy"
    },
    "custom_evidence_requirements": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewEvidenceRequirement"
      }
    },
    "custom_objectives": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewObjective"
      }
    },
    "custom_style_doctrines": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/StyleDoctrine"
      }
    },
    "custom_subagents": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewSubagentProfile"
      }
    },
    "custom_validation_gates": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ValidationGate"
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "overrides": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewDoctrineOverride"
      }
    },
    "presets": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewDoctrinePreset"
      }
    }
  },
  "required": [
    "enabled",
    "coverage"
  ],
  "$defs": {
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "patch",
        "test_result",
        "report",
        "pull_request",
        "workspace_snapshot",
        "git_branch",
        "git_commit",
        "git_worktree",
        "object_storage_object",
        "object_storage_prefix",
        "artifact_manifest",
        "schema",
        "other"
      ]
    },
    "ModelFeature": {
      "type": "string",
      "enum": [
        "tool_use",
        "json_schema",
        "streaming",
        "vision",
        "long_context",
        "reasoning",
        "embeddings",
        "local_weights"
      ]
    },
    "ReviewDoctrineCoveragePolicy": {
      "type": "object",
      "properties": {
        "allow_not_applicable": {
          "type": "boolean"
        },
        "min_objective_score": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "require_gate_results": {
          "type": "boolean"
        },
        "require_objective_results": {
          "type": "boolean"
        },
        "require_required_evidence": {
          "type": "boolean"
        }
      },
      "required": [
        "require_objective_results",
        "require_gate_results",
        "require_required_evidence",
        "allow_not_applicable"
      ]
    },
    "ReviewDoctrineOverride": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ReviewDoctrineOverrideAction"
        },
        "id": {
          "type": "string"
        },
        "min_score": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "note": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ReviewDoctrineOverrideTarget"
        }
      },
      "required": [
        "target",
        "id",
        "action",
        "note"
      ]
    },
    "ReviewDoctrineOverrideAction": {
      "type": "string",
      "enum": [
        "disable",
        "require",
        "make_optional",
        "set_min_score"
      ]
    },
    "ReviewDoctrineOverrideTarget": {
      "type": "string",
      "enum": [
        "objective",
        "evidence_requirement",
        "style_doctrine",
        "validation_gate",
        "subagent"
      ]
    },
    "ReviewDoctrinePreset": {
      "type": "string",
      "enum": [
        "core_engineering",
        "testing",
        "formal_methods",
        "functional_domain_driven_design",
        "laziness_lost",
        "security",
        "performance"
      ]
    },
    "ReviewEvidenceKind": {
      "type": "string",
      "enum": [
        "compile",
        "automated_tests",
        "property_tests",
        "type_check",
        "formal_proof",
        "static_analysis",
        "code_inspection",
        "architecture_review",
        "style_review",
        "security_scan",
        "performance_benchmark",
        "documentation_review",
        "external_reference",
        "custom"
      ]
    },
    "ReviewEvidenceRequirement": {
      "type": "object",
      "properties": {
        "applies_to_objective_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "artifact_kinds": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactKind"
          }
        },
        "commands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReviewEvidenceKind"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required"
      ]
    },
    "ReviewObjective": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/ReviewObjectiveCategory"
        },
        "description": {
          "type": "string"
        },
        "evidence_requirement_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "min_score": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "required": {
          "type": "boolean"
        },
        "severity_if_failed": {
          "$ref": "#/$defs/ReviewSeverity"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "description",
        "required",
        "severity_if_failed"
      ]
    },
    "ReviewObjectiveCategory": {
      "type": "string",
      "enum": [
        "correctness",
        "code_review",
        "testing",
        "hypothesis_testing",
        "type_soundness",
        "formal_verification",
        "code_quality",
        "code_style",
        "architecture",
        "domain_modeling",
        "functional_design",
        "denotational_semantics",
        "abstraction_quality",
        "simplicity",
        "security",
        "performance",
        "reliability",
        "observability",
        "documentation",
        "custom"
      ]
    },
    "ReviewReference": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "uri",
        "note"
      ]
    },
    "ReviewSeverity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "ReviewSubagentProfile": {
      "type": "object",
      "properties": {
        "evidence_requirement_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "inherited_by_default": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "objective_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "prompt_hints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "required_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerCapability"
          }
        },
        "required_model_features": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "validation_gate_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "inherited_by_default"
      ]
    },
    "RunnerCapability": {
      "type": "string",
      "enum": [
        "code",
        "research",
        "test",
        "review",
        "mcp_tools",
        "oidc_user_delegation",
        "workspace_sandbox",
        "container_sandbox",
        "gvisor_sandbox",
        "firecracker_sandbox",
        "kata_sandbox",
        "kubernetes_job_sandbox",
        "namespace_jail_sandbox",
        "provider_sandbox",
        "git_worktree",
        "git",
        "object_storage",
        "s3_compatible",
        "browser",
        "notifications",
        "local_models",
        "vllm",
        "open_ai_compatible",
        "gpu",
        "network_open",
        "formal_verification"
      ]
    },
    "StyleDoctrine": {
      "type": "object",
      "properties": {
        "anti_patterns": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "positive_indicators": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ReviewReference"
          }
        },
        "required": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "required"
      ]
    },
    "ValidationGate": {
      "type": "object",
      "properties": {
        "applies_to_roles": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkerKind"
          }
        },
        "description": {
          "type": "string"
        },
        "evidence_requirement_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "failure_blocks": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ValidationGateKind"
        },
        "min_score": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required",
        "failure_blocks"
      ]
    },
    "ValidationGateKind": {
      "type": "string",
      "enum": [
        "compile",
        "test_suite",
        "property_testing",
        "type_soundness",
        "formal_verification",
        "static_analysis",
        "code_review",
        "architecture_review",
        "style_review",
        "security_review",
        "performance_benchmark",
        "documentation_review",
        "custom"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
