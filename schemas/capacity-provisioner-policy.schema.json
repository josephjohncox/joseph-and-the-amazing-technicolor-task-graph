{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapacityProvisionerPolicy",
  "type": "object",
  "properties": {
    "allow_manual_manifest_escape_hatch": {
      "type": "boolean"
    },
    "backend": {
      "$ref": "#/$defs/CapacityProvisionerBackend"
    },
    "controller_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "field_manager": {
      "type": "string"
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_account": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "backend",
    "field_manager",
    "allow_manual_manifest_escape_hatch"
  ],
  "$defs": {
    "CapacityProvisionerBackend": {
      "type": "string",
      "enum": [
        "kubernetes_controller",
        "kubernetes_api",
        "external_provisioner",
        "manual_manifest"
      ]
    }
  }
}
