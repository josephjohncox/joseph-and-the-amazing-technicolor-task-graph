{
  "id": "github-actions-checks",
  "kind": "github_actions_check",
  "enabled": true,
  "description": "GitHub Actions workflow_run and check_run status events normalized into pull-request check activity.",
  "namespace": "coat",
  "webhook": null,
  "generic": {
    "auth": {
      "kind": "bearer_token",
      "secret_ref": {
        "provider": "env",
        "name": "COAT_GITHUB_ACTIONS_SIGNAL_TOKEN",
        "key": null,
        "namespace": null,
        "audience": "coat-event-gateway"
      },
      "header_name": "authorization"
    },
    "accepts_cloudevents": true,
    "max_payload_bytes": 1048576,
    "allowed_event_types": [
      "github.workflow_run.completed",
      "github.check_run.completed",
      "github.check_suite.completed"
    ],
    "id_json_pointer": "/workflow_run/id",
    "type_json_pointer": "/type",
    "subject_json_pointer": "/subject",
    "dedupe_json_pointer": "/delivery_id",
    "dedupe_header": "x-github-delivery",
    "payload_schema": null,
    "mcp_context": null
  },
  "sqs": null,
  "schedule": null,
  "calendar": null,
  "route": {
    "mode": "create_goal",
    "goal_template": {
      "title_template": "Fix GitHub Actions failure for {{subject}}",
      "objective_template": "Investigate GitHub Actions event {{event_id}} for {{subject}}. Read payload._coat_change_activity for repo, branch, PR, workflow, run URL, commit SHA, status, and conclusion. Search durable memory and recent PR context before proposing or applying a bounded fix. Return evidence from the relevant local or CI-equivalent checks.",
      "repo": "example/repo",
      "worker_role": "tester",
      "tags": [
        "github-actions",
        "pull-request",
        "ci",
        "test-failure"
      ]
    },
    "target_goal_id": null,
    "steering_directive": null,
    "require_approval": false,
    "dedupe_window_seconds": 3600
  }
}
