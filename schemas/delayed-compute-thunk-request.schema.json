{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelayedComputeThunkRequest",
  "type": "object",
  "properties": {
    "continuation": {
      "$ref": "#/$defs/ContinuationRef"
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "$ref": "#/$defs/DelayedComputeThunkKind"
    },
    "reason": {
      "type": "string"
    },
    "requested_input": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "timeout_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "wait_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/WaitRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "goal_id",
    "kind",
    "reason",
    "continuation"
  ],
  "$defs": {
    "ContinuationBoundary": {
      "type": "string",
      "enum": [
        "goal_workflow",
        "task_dispatch",
        "approval_gate",
        "event_wait",
        "external_callback"
      ]
    },
    "ContinuationRef": {
      "type": "object",
      "properties": {
        "boundary": {
          "$ref": "#/$defs/ContinuationBoundary"
        },
        "continuation_id": {
          "type": "string"
        },
        "resume_actions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ContinuationResumeAction"
          }
        },
        "state_ref": {
          "type": "string"
        }
      },
      "required": [
        "continuation_id",
        "boundary",
        "state_ref"
      ]
    },
    "ContinuationResumeAction": {
      "type": "string",
      "enum": [
        "mark_runnable",
        "apply_feedback",
        "apply_approval",
        "inject_task",
        "replan",
        "cancel"
      ]
    },
    "DelayedComputeThunkKind": {
      "type": "string",
      "enum": [
        "human_input",
        "approval",
        "external_event",
        "timer",
        "resource_availability",
        "model_availability",
        "webhook_callback"
      ]
    },
    "WaitRef": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WaitRefKind"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference"
      ]
    },
    "WaitRefKind": {
      "type": "string",
      "enum": [
        "human_thread",
        "notification_outbox",
        "sqs_message",
        "webhook_correlation",
        "calendar_event",
        "durable_timer",
        "runner_capacity",
        "model_route"
      ]
    }
  }
}
