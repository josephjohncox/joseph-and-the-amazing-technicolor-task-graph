{
  "title": "Branch candidate implementations",
  "objective": "Implement the same durable subgoal through multiple isolated candidate branches, collect reviewer votes, and select one implementation before the goal can be satisfied.",
  "repo": null,
  "root_budget": {
    "max_tokens": 2000000,
    "remaining_tokens": 2000000,
    "max_runtime_seconds": 14400,
    "remaining_runtime_seconds": 14400,
    "max_tool_calls": 2000,
    "remaining_tool_calls": 2000,
    "max_child_tasks": 64,
    "remaining_child_tasks": 64,
    "max_patch_size": 500000
  },
  "done_criteria": {
    "tests_pass": true,
    "artifact_exists": true,
    "validator_score_min": 0.85
  },
  "restart_policy": {
    "enabled": true,
    "max_goal_restarts": 3,
    "max_task_restarts": 5,
    "reset_attempts_on_restart": false,
    "preserve_artifacts": true,
    "allowed_scopes": ["goal", "task", "blocked", "timed_out"],
    "allowed_reasons": ["operator_requested", "runner_lost", "task_timed_out", "goal_timed_out", "config_changed", "model_changed"]
  },
  "timeout_policy": {
    "enabled": true,
    "goal_timeout_seconds": 14400,
    "task_run_timeout_seconds": 3600,
    "idle_timeout_seconds": 900,
    "approval_timeout_seconds": 3600,
    "runner_dispatch_timeout_seconds": 30,
    "runner_call_timeout_seconds": 3600,
    "on_goal_timeout": "block_and_notify",
    "on_task_timeout": "restart_if_allowed"
  },
  "branching_policy": {
    "enabled": true,
    "max_branch_groups": 8,
    "max_candidates_per_group": 4,
    "branch_on_root": true,
    "branch_on_subgoals": true,
    "cancel_original_on_branch": true,
    "require_model_diversity": true,
    "default_selection_strategy": "voter_quorum",
    "voting": {
      "enabled": true,
      "min_votes": 2,
      "voter_roles": ["reviewer", "tester"],
      "require_unification": true,
      "unifier_role": "patch_merger"
    }
  },
  "default_execution": {
    "runner": {
      "worker": "codex",
      "runner_id": null,
      "required_capabilities": ["code", "git_worktree", "mcp_tools"],
      "required_labels": {},
      "locality": "any_node"
    },
    "model": {
      "strategy": "highest_quality",
      "required_features": ["tool_use", "json_schema"],
      "candidates": [
        {
          "provider": "codex",
          "model": "codex-default",
          "endpoint": null,
          "priority": 10,
          "weight": 1,
          "context_window": null,
          "features": ["tool_use", "json_schema"],
          "labels": {"quality_tier": "frontier"}
        },
        {
          "provider": "vllm",
          "model": "qwen3-coder-30b",
          "endpoint": "http://vllm:8000/v1",
          "priority": 20,
          "weight": 1,
          "context_window": 131072,
          "features": ["tool_use", "json_schema", "long_context", "local_weights"],
          "labels": {"quality_tier": "high"}
        }
      ],
      "fallback": "allow_fallback"
    },
    "persona": {
      "name": "codex",
      "instructions_ref": null,
      "inline_instructions": ["Produce implementation evidence that another branch can independently review."],
      "risk_tolerance": "conservative"
    },
    "mcp": {
      "context_id": null,
      "servers": [],
      "secret_refs": [],
      "propagation": "runner_resolves_refs",
      "token_ttl_seconds": 900,
      "auth_distribution": {
        "mode": "runner_resolves_refs",
        "allowed_materials": ["api_token", "mcp_bearer_token", "oauth_access_token", "oauth_refresh_token", "workload_identity_token"],
        "required_runner_labels": {},
        "lease_ttl_seconds": 900,
        "renewal": "manual_or_brokered",
        "allow_node_local_device_session": true,
        "allow_secret_sync": false,
        "require_human_approval_for_brokered_user_auth": true
      }
    },
    "notifications": {
      "events": ["approval_requested", "human_feedback_requested", "task_blocked"],
      "targets": [],
      "feedback_thread_key": null,
      "escalation_seconds": 3600
    },
    "results": {
      "git": {
        "enabled": true,
        "remote": "origin",
        "base_ref": "HEAD",
        "branch_prefix": "jattg/task",
        "worktree_root": "/worktrees",
        "push_on_success": false,
        "require_clean_diff": true,
        "include_patch_artifact": true
      },
      "object_storage": {
        "enabled": false,
        "store": null,
        "key_prefix_template": "goals/{goal_id}/tasks/{task_id}",
        "require_manifest": true,
        "max_inline_bytes": 262144
      }
    }
  },
  "initial_tasks": []
}
