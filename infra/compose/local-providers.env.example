# Local provider credentials and model endpoints for COAT Compose.
# Copy to local-providers.env with `coat setup local-auth --write-env`.
# Validate before Compose with `coat deploy local preflight --env-file infra/compose/local-providers.env`.
#
# Keep the copied file out of git when it contains real credentials.
# Stub modes are safe for smoke tests; switch to live modes only inside
# approved isolated runners.

# Runner modes.
CODEX_RUNNER_MODE=stub
CODEX_REVIEW_RUNNER_MODE=stub
CLAUDE_CODE_RUNNER_MODE=stub
STAFF_ENGINEER_RUNNER_MODE=stub
MODEL_PROVIDER_RUNNER_MODE=stub
MODEL_PROVIDER_RESEARCH_RUNNER_MODE=stub
MODEL_PROVIDER_LOCAL_RUNNER_MODE=stub

# Verification probes are opt-in so setup checks do not start live agents.
CODEX_VERIFY_MCP=0
CODEX_VERIFY_APP_SERVER=0
CLAUDE_CODE_VERIFY_CLI=0
MODEL_PROVIDER_VERIFY_ENDPOINT=0

# Local binary execution is opt-in and still requires task approval by default.
# Use only on isolated runner nodes or local smoke stacks you control.
SANDBOX_ENABLE_LOCAL_COMMAND_EXECUTION=false
SANDBOX_REQUIRE_COMMAND_APPROVAL=true
SANDBOX_ALLOWED_LOCAL_BINARIES=git,make,cargo,npm,pnpm,yarn,node,python3,python,pytest,go,buf,docker,helm,kubectl
SANDBOX_COMMAND_TIMEOUT_SECONDS=600
SANDBOX_COMMAND_MAX_OUTPUT_BYTES=65536

# Hosted provider credentials. Prefer short-lived tokens or workload identity
# for production; never place these values in goal JSON or task state.
# Auth mode values are explicit so preflight can distinguish "missing token" from
# "runner-local device/browser auth will satisfy this lane after operator login".
CODEX_AUTH_MODE=env_api_key
CODEX_APP_SERVER_URL=
CODEX_AUTH_STATE_PATH=
CODEX_RUNNER_LABELS_JSON={"pool":"default","runtime":"codex","auth.codex.device":"false","auth.codex.api_key":"env","auth.mode":"env_api_key"}
CODEX_REVIEW_RUNNER_LABELS_JSON={"pool":"default","runtime":"codex","lane":"review","auth.codex.device":"false","auth.codex.api_key":"env","auth.mode":"env_api_key"}
CLAUDE_CODE_AUTH_MODE=env_api_key
STAFF_ENGINEER_AUTH_MODE=env_api_key
CLAUDE_CODE_AUTH_STATE_PATH=
CLAUDE_CODE_RUNNER_LABELS_JSON={"pool":"default","runtime":"claude-code","auth.claude.device":"false","auth.claude.api_key":"env","auth.mode":"env_api_key"}
STAFF_ENGINEER_RUNNER_LABELS_JSON={"pool":"default","runtime":"staff-engineer","auth.claude.device":"false","auth.claude.api_key":"env","auth.mode":"env_api_key"}
OPENAI_API_KEY=
CODEX_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

# Shared LLM gateway routing. Use this for Bifrost, LiteLLM, OpenRouter,
# Docker Model Gateway, or another OpenAI-compatible gateway that owns provider
# keys and routing policy. Direct personal setups can leave this block empty and
# use provider-specific keys above/below instead.
COAT_LLM_GATEWAY_PROVIDER=
COAT_LLM_GATEWAY_URL=
COAT_LLM_GATEWAY_CHAT_COMPLETIONS_URL=
COAT_LLM_GATEWAY_API_KEY=
COAT_LLM_GATEWAY_AUTH_MODE=api_key_or_none
COAT_LLM_GATEWAY_DEFAULT_MODEL=
COAT_LLM_GATEWAY_WORK_MODEL=
COAT_LLM_GATEWAY_RESEARCH_MODEL=
COAT_LLM_GATEWAY_CHAT_MODEL=
COAT_LLM_GATEWAY_EMBEDDING_MODEL=

# Routed web/reference search. The MCP tool `coat_web_search` compiles to a
# durable research task by default; set route=runner_registry only when a
# research runner advertises web_search and the network policy allows it.
COAT_WEB_SEARCH_ENABLED=false
COAT_WEB_SEARCH_ROUTE=coordinator_task
COAT_WEB_SEARCH_PROVIDER=agent_native
COAT_WEB_SEARCH_URL=
COAT_WEB_SEARCH_AUTH_MODE=api_key_or_none
COAT_WEB_SEARCH_API_KEY=
COAT_WEB_SEARCH_DEFAULT_LIMIT=10
COAT_WEB_SEARCH_MAX_LIMIT=25
CODEX_NATIVE_WEB_SEARCH=false
CLAUDE_CODE_NATIVE_WEB_SEARCH=false
MODEL_PROVIDER_WEB_SEARCH_ENABLED=false
MODEL_PROVIDER_RESEARCH_WEB_SEARCH_ENABLED=false

# Bedrock and AWS-compatible model provider routing.
AWS_PROFILE=
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Stable SQS adapter for inbound event polling and outbound notification fanout.
# For AWS, leave endpoint empty and use the standard AWS env/workload identity
# credentials. For LocalStack, set an endpoint such as http://localstack:4566.
COAT_SQS_REGION=us-west-2
COAT_SQS_ENDPOINT_URL=
COAT_SQS_MESSAGE_GROUP_ID=

# Primary OpenAI-compatible provider runner.
MODEL_PROVIDER_KIND=open_ai_compatible
MODEL_PROVIDER_AUTH_MODE=api_key_or_none
MODEL_PROVIDER_MODEL=
MODEL_PROVIDER_ENDPOINT=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_LATENCY_CLASS=
MODEL_PROVIDER_SPEED_TIER=
MODEL_PROVIDER_TEMPERATURE=
MODEL_PROVIDER_TOP_P=
MODEL_PROVIDER_MAX_OUTPUT_TOKENS=
MODEL_PROVIDER_REASONING_EFFORT=
MODEL_PROVIDER_TIMEOUT_SECONDS=

# Dedicated research lane provider runner.
MODEL_PROVIDER_RESEARCH_KIND=open_ai_compatible
MODEL_PROVIDER_RESEARCH_AUTH_MODE=api_key_or_none
MODEL_PROVIDER_RESEARCH_MODEL=
MODEL_PROVIDER_RESEARCH_ENDPOINT=
MODEL_PROVIDER_RESEARCH_API_KEY=
MODEL_PROVIDER_RESEARCH_LATENCY_CLASS=
MODEL_PROVIDER_RESEARCH_SPEED_TIER=
MODEL_PROVIDER_RESEARCH_TEMPERATURE=
MODEL_PROVIDER_RESEARCH_TOP_P=
MODEL_PROVIDER_RESEARCH_MAX_OUTPUT_TOKENS=
MODEL_PROVIDER_RESEARCH_REASONING_EFFORT=
MODEL_PROVIDER_RESEARCH_TIMEOUT_SECONDS=
HF_TOKEN=
HUGGINGFACE_TOKEN=

# Host-local model runner. Ollama's OpenAI-compatible endpoint is commonly
# available at http://localhost:11434/v1 on the host, which is
# host.docker.internal from Compose containers.
LOCAL_MODEL_PROVIDER_KIND=ollama
LOCAL_MODEL_PROVIDER_AUTH_MODE=none
LOCAL_MODEL_PROVIDER_MODEL=
LOCAL_MODEL_PROVIDER_ENDPOINT=http://host.docker.internal:11434/v1
LOCAL_MODEL_PROVIDER_LATENCY_CLASS=fast
LOCAL_MODEL_PROVIDER_SPEED_TIER=
LOCAL_MODEL_PROVIDER_TEMPERATURE=0.2
LOCAL_MODEL_PROVIDER_TOP_P=0.9
LOCAL_MODEL_PROVIDER_MAX_OUTPUT_TOKENS=2048
LOCAL_MODEL_PROVIDER_REASONING_EFFORT=low
LOCAL_MODEL_PROVIDER_TIMEOUT_SECONDS=60

# Optional control gateway Chat tab model. This is separate from the runner
# fleet: runner lanes use MODEL_PROVIDER_*/LOCAL_MODEL_PROVIDER_* based on role,
# persona, sandbox, and task routing; the gateway uses these COAT_CONTROL_CHAT_*
# values for operator chat only. The default backend is `configured`, which
# means explicit chat config or stub. Set `runner_registry` only when operator
# chat should intentionally borrow a chat-labeled runner.
COAT_CONTROL_CHAT_BACKEND=configured
COAT_CONTROL_CHAT_PROVIDER=
COAT_CONTROL_CHAT_COMPLETIONS_URL=
COAT_CONTROL_CHAT_MODEL=
COAT_CONTROL_CHAT_API_KEY=
COAT_CONTROL_CHAT_LATENCY_CLASS=
COAT_CONTROL_CHAT_SPEED_TIER=
COAT_CONTROL_CHAT_TEMPERATURE=
COAT_CONTROL_CHAT_TOP_P=
COAT_CONTROL_CHAT_MAX_OUTPUT_TOKENS=
COAT_CONTROL_CHAT_REASONING_EFFORT=
COAT_CONTROL_CHAT_TIMEOUT_SECONDS=

# Memory stores and embeddings. Store adapters are explicit so local smoke tests
# can run on the JSONL journal without accidentally depending on hosted
# embeddings. Use `coat setup local-auth` to select Qdrant, Graphiti/Zep MCP,
# OpenAI hosted embeddings, Ollama, vLLM, llama.cpp, or another
# OpenAI-compatible embedding endpoint.
MEMORY_GATEWAY_GRAPHITI_MCP_URL=
MEMORY_GATEWAY_GRAPHITI_GROUP_ID=jattg
MEMORY_GATEWAY_GRAPHITI_TOKEN=
MEMORY_GATEWAY_QDRANT_URL=
MEMORY_GATEWAY_QDRANT_COLLECTION=jattg_memory
MEMORY_GATEWAY_QDRANT_TOKEN=
MEMORY_GATEWAY_EMBEDDING_URL=
MEMORY_GATEWAY_EMBEDDING_MODEL=
MEMORY_GATEWAY_EMBEDDING_DIMENSIONS=
MEMORY_GATEWAY_EMBEDDING_TOKEN=
MEMORY_GATEWAY_EMBEDDING_SEND_DIMENSIONS=false
