{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryJoinRequest",
  "type": "object",
  "properties": {
    "branch_task_ids": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "invalidate_keys": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "promote_keys": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "store": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemoryStoreRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "unifier_task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "goal_id",
    "reason"
  ],
  "$defs": {
    "MemoryStoreKind": {
      "type": "string",
      "enum": [
        "zep_graphiti",
        "letta",
        "postgres_pgvector",
        "qdrant",
        "lance_db",
        "sqlite",
        "other"
      ]
    },
    "MemoryStoreRef": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MemoryStoreKind"
        },
        "mcp_server_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_refs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "ReviewDecision": {
      "type": "string",
      "enum": [
        "accept",
        "changes_requested",
        "blocked",
        "inconclusive"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    }
  }
}
