{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewFinding",
  "type": "object",
  "properties": {
    "body": {
      "type": "string"
    },
    "end_line": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "severity": {
      "$ref": "#/$defs/ReviewSeverity"
    },
    "start_line": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "suggested_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "severity",
    "title",
    "body"
  ],
  "$defs": {
    "ReviewSeverity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
