        ],
        "test_evidence": [
          {
            "command": "coat scenario run --file scenarios/e2e/operator_usability_workbench.json",
            "result": "passed"
          }
        ]
      }
    },
    {
      "id": "validate_goal",
      "type": "validate_goal",
      "goal_id": "00000000-0000-4000-8000-000000004201",
      "after": ["complete_worker_run"],
      "expect": {
        "goal_status": "done"
      }
    }
