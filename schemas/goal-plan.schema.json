{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalPlan",
  "type": "object",
  "properties": {
    "distribution_notes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "subgoals": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SubgoalSpec"
      }
    },
    "summary": {
      "type": "string",
      "default": ""
    }
  },
  "$defs": {
    "GraphColorRef": {
      "description": "Optional visual metadata for the Technicolor Task Graph.\n\nColors are presentation hints for dashboards, screenshots, and operator\nreadability. They must not drive routing, budgets, validation, approvals,\nor any other coordinator policy.",
      "type": "object",
      "properties": {
        "hex": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "hex",
        "meaning"
      ]
    },
    "SubgoalSpec": {
      "type": "object",
      "properties": {
        "acceptance_evidence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphColorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "owner_role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "priority": {
          "$ref": "#/$defs/TaskPriority",
          "default": "normal"
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "owner_role"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "normal",
        "low",
        "background"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "claude_code",
        "staff_engineer_claude",
        "model_provider",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
