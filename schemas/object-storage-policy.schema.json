{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObjectStoragePolicy",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "key_prefix_template": {
      "type": "string"
    },
    "max_inline_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "require_manifest": {
      "type": "boolean"
    },
    "store": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectStoreRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "enabled",
    "key_prefix_template",
    "require_manifest",
    "max_inline_bytes"
  ],
  "$defs": {
    "ObjectStoreKind": {
      "type": "string",
      "enum": [
        "aws_s3",
        "s3_compatible",
        "minio",
        "cloudflare_r2",
        "gcs_s3",
        "other"
      ]
    },
    "ObjectStoreRef": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "force_path_style": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ObjectStoreKind"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "bucket",
        "force_path_style"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    }
  }
}
