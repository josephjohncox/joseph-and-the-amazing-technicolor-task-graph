{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchSelectionRequest",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "group_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "selected_task_id": {
      "type": "string",
      "format": "uuid"
    },
    "selector": {
      "$ref": "#/$defs/BranchSelector"
    }
  },
  "required": [
    "goal_id",
    "group_id",
    "selected_task_id",
    "selector",
    "reason"
  ],
  "$defs": {
    "BranchSelector": {
      "type": "string",
      "enum": [
        "human",
        "voter_quorum",
        "highest_score",
        "unifier",
        "coordinator_policy"
      ]
    }
  }
}
