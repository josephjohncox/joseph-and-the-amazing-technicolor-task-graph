{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DurablePlanSummary",
  "type": "object",
  "properties": {
    "compiled_goal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "initial_task_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/$defs/PlanningMode"
    },
    "objective": {
      "type": "string"
    },
    "open_question_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/PlanStatus"
    },
    "subgoal_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "plan_id",
    "title",
    "objective",
    "status",
    "mode",
    "version",
    "subgoal_count",
    "initial_task_count",
    "open_question_count"
  ],
  "$defs": {
    "PlanStatus": {
      "type": "string",
      "enum": [
        "draft",
        "needs_questions",
        "ready_for_review",
        "approved",
        "compiled",
        "superseded",
        "archived"
      ]
    },
    "PlanningMode": {
      "type": "string",
      "enum": [
        "interactive",
        "autonomous",
        "human_steered",
        "research_first",
        "implementation_ready"
      ]
    }
  }
}
