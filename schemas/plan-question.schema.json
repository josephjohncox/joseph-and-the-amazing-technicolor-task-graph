{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanQuestion",
  "type": "object",
  "properties": {
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/PlanQuestionStatus"
    }
  },
  "required": [
    "id",
    "question",
    "required",
    "status"
  ],
  "$defs": {
    "PlanQuestionStatus": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "deferred"
      ]
    }
  }
}
