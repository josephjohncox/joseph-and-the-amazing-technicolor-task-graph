{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalStoreApprovalListResponse",
  "type": "object",
  "properties": {
    "approvals": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ApprovalRecord"
      }
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "goal_id"
  ],
  "$defs": {
    "ApprovalRecord": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "goal_id": {
          "type": "string",
          "format": "uuid"
        },
        "payload_json": {
          "default": null
        },
        "reason": {
          "type": "string"
        },
        "requested_action": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/ApprovalRisk"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "approval_id",
        "goal_id",
        "status",
        "risk",
        "reason",
        "requested_action"
      ]
    },
    "ApprovalRisk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ]
    }
  }
}
