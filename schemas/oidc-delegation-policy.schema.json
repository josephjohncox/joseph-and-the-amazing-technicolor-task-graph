{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OidcDelegationPolicy",
  "type": "object",
  "properties": {
    "allowed_mcp_servers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "audiences": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "client_id": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "lease_ttl_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "pass_id_token_to_mcp": {
      "type": "boolean",
      "default": false
    },
    "requested_scopes": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "require_user_consent": {
      "type": "boolean",
      "default": true
    },
    "required_runner_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "token_broker": {
      "$ref": "#/$defs/SecretRef"
    },
    "token_cache_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SecretRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "issuer",
    "client_id",
    "token_broker"
  ],
  "$defs": {
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    }
  }
}
