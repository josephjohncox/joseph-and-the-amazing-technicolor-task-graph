{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunnerScalingRequest",
  "type": "object",
  "properties": {
    "demands": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RunnerPoolDemand"
      }
    },
    "generated_at_unix_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "policy": {
      "$ref": "#/$defs/CapacityScalingPolicy",
      "default": {
        "cooldown_seconds": 300,
        "enabled": false,
        "event_weight": 1,
        "headroom_runners": 0,
        "max_runners": 8,
        "max_scale_down_step": 1,
        "max_scale_up_step": 2,
        "min_runners": 0,
        "mode": "recommend_only",
        "scale_from_events": true,
        "slots_per_runner": 1,
        "target_backlog_per_runner": 2,
        "target_utilization_percent": 75
      }
    },
    "supplies": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RunnerPoolSupply"
      }
    }
  },
  "required": [
    "generated_at_unix_seconds"
  ],
  "$defs": {
    "CapacityScalingMode": {
      "type": "string",
      "enum": [
        "manual",
        "recommend_only",
        "provision_ephemeral"
      ]
    },
    "CapacityScalingPolicy": {
      "description": "Bounded policy for dynamically adding or retiring runner capacity.\n\nThe coordinator computes durable demand from runnable tasks, events, and\nqueue processors. A provisioner may realize the resulting recommendations,\nbut only within these limits and the surrounding approval policy.",
      "type": "object",
      "properties": {
        "cooldown_seconds": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "event_weight": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "headroom_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "max_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 8,
          "minimum": 0
        },
        "max_scale_down_step": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "max_scale_up_step": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "min_runners": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/CapacityScalingMode",
          "default": "recommend_only"
        },
        "scale_from_events": {
          "type": "boolean",
          "default": true
        },
        "slots_per_runner": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "target_backlog_per_runner": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "target_utilization_percent": {
          "type": "integer",
          "format": "uint32",
          "default": 75,
          "minimum": 0
        }
      }
    },
    "RunnerCapability": {
      "type": "string",
      "enum": [
        "code",
        "research",
        "web_search",
        "test",
        "review",
        "mcp_tools",
        "durable_child_tasks",
        "oidc_user_delegation",
        "local_commands",
        "git_cli",
        "docker_cli",
        "helm_cli",
        "kubernetes_cli",
        "build_tooling",
        "package_manager_cli",
        "workspace_sandbox",
        "container_sandbox",
        "gvisor_sandbox",
        "firecracker_sandbox",
        "kata_sandbox",
        "kubernetes_job_sandbox",
        "namespace_jail_sandbox",
        "provider_sandbox",
        "git_worktree",
        "git",
        "object_storage",
        "s3_compatible",
        "browser",
        "notifications",
        "local_models",
        "vllm",
        "open_ai_compatible",
        "gpu",
        "ephemeral_provisioning",
        "network_open",
        "formal_verification"
      ]
    },
    "RunnerPoolDemand": {
      "type": "object",
      "properties": {
        "blocked_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "event_backlog": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pool_key": {
          "type": "string"
        },
        "priority_boost": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "queued_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "required_capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunnerCapability"
          }
        },
        "required_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "running_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unmatched_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "worker": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkerKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "pool_key",
        "queued_tasks",
        "running_tasks",
        "blocked_tasks",
        "unmatched_tasks",
        "event_backlog",
        "priority_boost"
      ]
    },
    "RunnerPoolSupply": {
      "type": "object",
      "properties": {
        "capacity_remaining": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "dispatchable_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_concurrency": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pending_provisions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pool_key": {
          "type": "string"
        },
        "registered_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "running_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "stale_runners": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "pool_key",
        "registered_runners",
        "dispatchable_runners",
        "running_tasks",
        "capacity_remaining",
        "max_concurrency",
        "pending_provisions",
        "stale_runners"
      ]
    },
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "claude_code",
        "staff_engineer_claude",
        "model_provider",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
