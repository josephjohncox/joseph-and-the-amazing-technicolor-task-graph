{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRunResult",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "branch_vote": {
      "anyOf": [
        {
          "$ref": "#/$defs/BranchVoteOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "child_requests": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ChildTaskRequest"
      }
    },
    "confidence": {
      "type": "number",
      "format": "float"
    },
    "diagnostics": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "git_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/GitResultRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mcp_context_used": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpContextRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_used": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelCandidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "notification_reports": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/NotificationDeliveryReport"
      }
    },
    "object_artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ObjectStorageArtifactRef"
      }
    },
    "research": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runner_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/WorkerRunStatus"
    },
    "summary": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "task_id",
    "status",
    "summary",
    "confidence"
  ],
  "$defs": {
    "ApprovalPolicy": {
      "type": "string",
      "enum": [
        "never",
        "on_request",
        "always"
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "patch",
        "test_result",
        "report",
        "pull_request",
        "workspace_snapshot",
        "git_branch",
        "git_commit",
        "git_worktree",
        "object_storage_object",
        "object_storage_prefix",
        "artifact_manifest",
        "schema",
        "other"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "description"
      ]
    },
    "AuthDistributionMode": {
      "type": "string",
      "enum": [
        "runner_local_only",
        "runner_resolves_refs",
        "coordinator_issues_lease",
        "workload_identity",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "AuthDistributionPolicy": {
      "type": "object",
      "properties": {
        "allow_node_local_device_session": {
          "type": "boolean"
        },
        "allow_secret_sync": {
          "type": "boolean"
        },
        "allowed_materials": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AuthMaterialKind"
          }
        },
        "lease_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/AuthDistributionMode"
        },
        "renewal": {
          "$ref": "#/$defs/AuthRenewalPolicy"
        },
        "require_human_approval_for_brokered_user_auth": {
          "type": "boolean"
        },
        "required_runner_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "mode",
        "renewal",
        "allow_node_local_device_session",
        "allow_secret_sync",
        "require_human_approval_for_brokered_user_auth"
      ]
    },
    "AuthMaterialKind": {
      "type": "string",
      "enum": [
        "api_token",
        "mcp_bearer_token",
        "oauth_access_token",
        "oauth_refresh_token",
        "device_auth_session",
        "workload_identity_token",
        "local_cli_session",
        "service_account",
        "other"
      ]
    },
    "AuthRenewalPolicy": {
      "type": "string",
      "enum": [
        "none",
        "manual_or_brokered",
        "broker_can_refresh",
        "runner_can_refresh"
      ]
    },
    "BranchVoteOutput": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "group_id": {
          "type": "string",
          "format": "uuid"
        },
        "ranked_task_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "rationale": {
          "type": "string"
        },
        "selected_task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "group_id",
        "selected_task_id",
        "confidence",
        "rationale"
      ]
    },
    "Budget": {
      "type": "object",
      "properties": {
        "max_child_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_patch_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_runtime_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remaining_child_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "remaining_runtime_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remaining_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "remaining_tool_calls": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "max_tokens",
        "remaining_tokens",
        "max_runtime_seconds",
        "remaining_runtime_seconds",
        "max_tool_calls",
        "remaining_tool_calls",
        "max_child_tasks",
        "remaining_child_tasks",
        "max_patch_size"
      ]
    },
    "ChildTaskRequest": {
      "type": "object",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "done_criteria": {
          "anyOf": [
            {
              "$ref": "#/$defs/DoneCriteria"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "$ref": "#/$defs/TaskPriority",
          "default": "normal"
        },
        "prompt": {
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskPurpose"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/WorkerKind"
        },
        "sandbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "subgoal_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "role",
        "prompt",
        "reason"
      ]
    },
    "DeviceAuthProvider": {
      "type": "string",
      "enum": [
        "codex",
        "claude_code",
        "open_ai",
        "anthropic",
        "github",
        "google",
        "other"
      ]
    },
    "DoneCriteria": {
      "type": "object",
      "properties": {
        "artifact_exists": {
          "type": "boolean"
        },
        "tests_pass": {
          "type": "boolean"
        },
        "validator_score_min": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "required": [
        "tests_pass",
        "artifact_exists"
      ]
    },
    "ExecutionProfile": {
      "type": "object",
      "properties": {
        "mcp": {
          "$ref": "#/$defs/McpContextRef"
        },
        "model": {
          "$ref": "#/$defs/ModelRoute"
        },
        "notifications": {
          "$ref": "#/$defs/NotificationPolicy"
        },
        "persona": {
          "$ref": "#/$defs/PersonaSpec"
        },
        "results": {
          "$ref": "#/$defs/ResultChannelPolicy",
          "default": {
            "git": {
              "base_ref": "HEAD",
              "branch_prefix": "coat/task",
              "enabled": false,
              "include_patch_artifact": true,
              "push_on_success": false,
              "remote": "origin",
              "require_clean_diff": true,
              "worktree_root": "/worktrees"
            },
            "object_storage": {
              "enabled": false,
              "key_prefix_template": "goals/{goal_id}/tasks/{task_id}",
              "max_inline_bytes": 262144,
              "require_manifest": true,
              "store": null
            }
          }
        },
        "runner": {
          "$ref": "#/$defs/RunnerSelector"
        }
      },
      "required": [
        "runner",
        "model",
        "persona",
        "mcp",
        "notifications"
      ]
    },
    "FilesystemAccess": {
      "type": "string",
      "enum": [
        "read_only",
        "workspace_write"
      ]
    },
    "GitResultPolicy": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_prefix": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "include_patch_artifact": {
          "type": "boolean"
        },
        "push_on_success": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "require_clean_diff": {
          "type": "boolean"
        },
        "worktree_root": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled",
        "branch_prefix",
        "push_on_success",
        "require_clean_diff",
        "include_patch_artifact"
      ]
    },
    "GitResultRef": {
      "type": "object",
      "properties": {
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "pushed": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "branch",
        "pushed"
      ]
    },
    "InformationUsePlan": {
      "type": "object",
      "properties": {
        "facts_to_avoid": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "facts_to_use": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "proposed_task_updates": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ChildTaskRequest"
          }
        },
        "validation_checks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "McpAuthRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secret"
            },
            "secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "workload_identity"
            }
          },
          "required": [
            "kind",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oauth_delegation"
            },
            "token_exchange_secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "token_exchange_secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "device_auth_session"
            },
            "node_local": {
              "type": "boolean",
              "default": true
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "refresh_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "session_ref": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "session_ref",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "kind": {
              "type": "string",
              "const": "brokered_user_session"
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "broker",
            "provider"
          ]
        }
      ]
    },
    "McpContextPropagation": {
      "type": "string",
      "enum": [
        "coordinator_issued",
        "runner_resolves_refs",
        "workload_identity",
        "runner_local_only",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "McpContextRef": {
      "type": "object",
      "properties": {
        "auth_distribution": {
          "$ref": "#/$defs/AuthDistributionPolicy",
          "default": {
            "allow_node_local_device_session": true,
            "allow_secret_sync": false,
            "allowed_materials": [
              "api_token",
              "mcp_bearer_token",
              "oauth_access_token",
              "oauth_refresh_token",
              "workload_identity_token"
            ],
            "lease_ttl_seconds": 900,
            "mode": "runner_resolves_refs",
            "renewal": "manual_or_brokered",
            "require_human_approval_for_brokered_user_auth": true,
            "required_runner_labels": {}
          }
        },
        "context_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "propagation": {
          "$ref": "#/$defs/McpContextPropagation"
        },
        "secret_refs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretRef"
          }
        },
        "servers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/McpServerRef"
          }
        },
        "token_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "propagation"
      ]
    },
    "McpServerRef": {
      "type": "object",
      "properties": {
        "allowed_tools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "$ref": "#/$defs/McpAuthRef"
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "transport",
        "uri",
        "auth"
      ]
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "ModelCandidate": {
      "type": "object",
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "model": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "provider": {
          "$ref": "#/$defs/ModelProviderKind"
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "provider",
        "model",
        "priority",
        "weight"
      ]
    },
    "ModelFallbackPolicy": {
      "type": "string",
      "enum": [
        "disallow_fallback",
        "allow_fallback",
        "allow_lower_tier_local"
      ]
    },
    "ModelFeature": {
      "type": "string",
      "enum": [
        "tool_use",
        "json_schema",
        "streaming",
        "vision",
        "long_context",
        "reasoning",
        "embeddings",
        "local_weights"
      ]
    },
    "ModelProviderKind": {
      "type": "string",
      "enum": [
        "codex",
        "open_ai",
        "open_ai_compatible",
        "vllm",
        "ollama",
        "llama_cpp",
        "anthropic",
        "hugging_face",
        "local_process",
        "other"
      ]
    },
    "ModelRoute": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelCandidate"
          }
        },
        "fallback": {
          "$ref": "#/$defs/ModelFallbackPolicy"
        },
        "required_features": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelFeature"
          }
        },
        "strategy": {
          "$ref": "#/$defs/ModelRoutingStrategy"
        }
      },
      "required": [
        "strategy",
        "fallback"
      ]
    },
    "ModelRoutingStrategy": {
      "type": "string",
      "enum": [
        "first_available",
        "lowest_latency",
        "lowest_cost",
        "highest_quality",
        "weighted",
        "sticky_per_goal"
      ]
    },
    "NetworkAccess": {
      "type": "string",
      "enum": [
        "disabled",
        "restricted",
        "open"
      ]
    },
    "NotificationDeliveryReport": {
      "type": "object",
      "properties": {
        "delivered": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/NotificationTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "delivered"
      ]
    },
    "NotificationEvent": {
      "type": "string",
      "enum": [
        "human_feedback_requested",
        "approval_requested",
        "task_blocked",
        "task_failed",
        "goal_completed",
        "budget_warning",
        "runner_lost"
      ]
    },
    "NotificationPolicy": {
      "type": "object",
      "properties": {
        "escalation_seconds": {
          "type": [
            "integer",
            "null"
          ],
