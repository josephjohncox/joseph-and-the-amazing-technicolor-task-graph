{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutorGuardrailPolicy",
  "type": "object",
  "properties": {
    "block_on_high_findings": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "max_inline_output_bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "output_reviewer_role": {
      "$ref": "#/$defs/WorkerKind"
    },
    "redact_secrets": {
      "type": "boolean"
    },
    "require_artifact_manifest": {
      "type": "boolean"
    },
    "require_output_review": {
      "type": "boolean"
    },
    "require_sandbox_attestation": {
      "type": "boolean"
    },
    "require_security_review": {
      "type": "boolean"
    },
    "require_strong_sandbox_attestation": {
      "type": "boolean"
    },
    "security_reviewer_role": {
      "$ref": "#/$defs/WorkerKind"
    }
  },
  "required": [
    "enabled",
    "require_output_review",
    "require_security_review",
    "output_reviewer_role",
    "security_reviewer_role",
    "block_on_high_findings",
    "require_artifact_manifest",
    "require_sandbox_attestation",
    "require_strong_sandbox_attestation",
    "redact_secrets",
    "max_inline_output_bytes"
  ],
  "$defs": {
    "WorkerKind": {
      "type": "string",
      "enum": [
        "planner",
        "codex",
        "staff_engineer_claude",
        "research",
        "reviewer",
        "tester",
        "formal_methods",
        "validator",
        "patch_merger",
        "rust_tool"
      ]
    }
  }
}
