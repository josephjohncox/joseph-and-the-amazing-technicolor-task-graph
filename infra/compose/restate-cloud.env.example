# Restate Cloud environment values for personal COAT runs.
# Copy to a local .env file or export these in your shell; do not commit tokens.

RESTATE_ENVIRONMENT_ID=env_...
RESTATE_BEARER_TOKEN=replace-me
RESTATE_TUNNEL_NAME=coat-personal
RESTATE_SIGNING_PUBLIC_KEY=publickeyv1_...
RESTATE_CLOUD_REGION=us

# The coordinator reads either variable. Set both for tools that expect one name
# or the other.
RESTATE_IDENTITY_KEYS=publickeyv1_...

# Compose maps the tunnel's remote ingress/admin proxies away from the local
# Restate ports so self-hosted and cloud profiles can coexist on one laptop.
RESTATE_TUNNEL_INGRESS_PORT=18080
RESTATE_TUNNEL_ADMIN_PORT=19070
RESTATE_TUNNEL_HEALTH_PORT=19090
COAT_RESTATE_INGRESS=http://localhost:18080
COAT_RESTATE_ADMIN=http://localhost:19070
COAT_COORDINATOR_RESTATE_ENDPOINT=http://localhost:9080
