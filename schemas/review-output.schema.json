{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewOutput",
  "type": "object",
  "properties": {
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "findings": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      }
    },
    "gate_results": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ValidationGateResult"
      }
    },
    "objective_results": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewObjectiveResult"
      }
    },
    "retry_recommended": {
      "type": "boolean"
    },
    "reward": {
      "type": "number",
      "format": "float"
    },
    "unification_summary": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "decision",
    "reward",
    "retry_recommended"
  ],
  "$defs": {
    "ReviewDecision": {
      "type": "string",
      "enum": [
        "accept",
        "changes_requested",
        "blocked",
        "inconclusive"
      ]
    },
    "ReviewFinding": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "severity": {
          "$ref": "#/$defs/ReviewSeverity"
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "suggested_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "title",
        "body"
      ]
    },
    "ReviewObjectiveDecision": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_applicable",
        "not_checked"
      ]
    },
    "ReviewObjectiveResult": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReviewObjectiveDecision"
        },
        "evidence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "objective_id": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "objective_id",
        "decision",
        "score"
      ]
    },
    "ReviewSeverity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "ValidationGateResult": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "gate_id": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "passed": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "gate_id",
        "passed",
        "score"
      ]
    }
  }
}
