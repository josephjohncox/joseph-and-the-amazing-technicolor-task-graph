# shellcheck shell=bash
#
# COAT local development environment.
# This file is intentionally safe to commit. It only adds checkout-local tools
# to PATH and asks direnv to reload when COAT config files change.
#
# Do not mirror service endpoints here. `coat` resolves `.coat/project.json`
# plus `~/.coat/config.json` itself, and profile switching should use
# `coat --config-profile ...` or a machine-local `.envrc.local` override.

# Put secrets, provider tokens, and rare local config/profile overrides in
# .envrc.local. Endpoint defaults belong in COAT config, not in direnv.
source_env_if_exists .envrc.local

coat_project_root="$PWD"
coat_target_dir="${CARGO_TARGET_DIR:-$coat_project_root/target}"
case "$coat_target_dir" in
  /*) ;;
  *) coat_target_dir="$coat_project_root/$coat_target_dir" ;;
esac

# COAT_BUILD_PROFILE chooses which checkout-local CLI binary shadows any
# globally installed `coat`. The default matches `cargo build`: target/debug.
case "${COAT_BUILD_PROFILE:-debug}" in
  debug | dev)
    export COAT_BUILD_PROFILE=debug
    coat_primary_bin_dir="$coat_target_dir/debug"
    coat_secondary_bin_dir="$coat_target_dir/release"
    ;;
  release | prod | production)
    export COAT_BUILD_PROFILE=release
    coat_primary_bin_dir="$coat_target_dir/release"
    coat_secondary_bin_dir="$coat_target_dir/debug"
    ;;
  *)
    echo "Unsupported COAT_BUILD_PROFILE='${COAT_BUILD_PROFILE}'. Use debug or release." >&2
    export COAT_BUILD_PROFILE=debug
    coat_primary_bin_dir="$coat_target_dir/debug"
    coat_secondary_bin_dir="$coat_target_dir/release"
    ;;
esac

export COAT_PROJECT_ROOT="$coat_project_root"
export COAT_TARGET_DIR="$coat_target_dir"
export COAT_BIN_DIR="$coat_primary_bin_dir"

# PATH_add prepends, so add lower-priority paths first and the configured COAT
# binary directory last. That keeps `cargo build` from being shadowed by a stale
# release build or globally installed CLI.
PATH_add "$coat_project_root/scripts"
#PATH_add "$coat_project_root/sidecars/codex-runner-ts/node_modules/.bin"
#PATH_add "$coat_project_root/sidecars/staff-engineer-runner-ts/node_modules/.bin"
#PATH_add "$coat_project_root/sidecars/claude-code-runner-ts/node_modules/.bin"
#PATH_add "$coat_project_root/sidecars/model-provider-runner-ts/node_modules/.bin"
PATH_add "$coat_project_root/ui/control-plane-web/node_modules/.bin"
PATH_add "$coat_secondary_bin_dir"
PATH_add "$coat_primary_bin_dir"

watch_file Cargo.toml
watch_file Cargo.lock
watch_file crates/cli/Cargo.toml
watch_file .nvmrc
watch_file .coat/project.json
watch_file "$HOME/.coat/config.json"
watch_file infra/compose/local-providers.env
watch_file infra/compose/restate-cloud.env
watch_file .envrc.local
