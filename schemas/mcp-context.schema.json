{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpContextRef",
  "description": "MCP context distributed by reference, never by raw credential value.\n\nThe coordinator stores server refs, allowed tools, secret refs, optional\nuser principal refs, and auth-distribution policy. Runners resolve usable\ncredentials locally or through brokers. See\n`docs/design-docs/040-auth-distribution.md` and\n`docs/design-docs/130-multi-user-oidc-mcp.md`.",
  "type": "object",
  "properties": {
    "access_mode": {
      "$ref": "#/$defs/McpAccessMode",
      "default": "single_user"
    },
    "auth_distribution": {
      "$ref": "#/$defs/AuthDistributionPolicy",
      "default": {
        "allow_node_local_device_session": true,
        "allow_secret_sync": false,
        "allowed_materials": [
          "api_token",
          "mcp_bearer_token",
          "oauth_access_token",
          "oauth_refresh_token",
          "workload_identity_token"
        ],
        "lease_ttl_seconds": 900,
        "mode": "runner_resolves_refs",
        "renewal": "manual_or_brokered",
        "require_human_approval_for_brokered_user_auth": true,
        "required_runner_labels": {}
      }
    },
    "context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "oidc_delegation": {
      "anyOf": [
        {
          "$ref": "#/$defs/OidcDelegationPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "propagation": {
      "$ref": "#/$defs/McpContextPropagation"
    },
    "secret_refs": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SecretRef"
      }
    },
    "servers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/McpServerRef"
      }
    },
    "token_ttl_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "user": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserPrincipalRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "propagation"
  ],
  "$defs": {
    "AuthDistributionMode": {
      "type": "string",
      "enum": [
        "runner_local_only",
        "runner_resolves_refs",
        "coordinator_issues_lease",
        "workload_identity",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "AuthDistributionPolicy": {
      "type": "object",
      "properties": {
        "allow_node_local_device_session": {
          "type": "boolean"
        },
        "allow_secret_sync": {
          "type": "boolean"
        },
        "allowed_materials": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AuthMaterialKind"
          }
        },
        "lease_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "$ref": "#/$defs/AuthDistributionMode"
        },
        "renewal": {
          "$ref": "#/$defs/AuthRenewalPolicy"
        },
        "require_human_approval_for_brokered_user_auth": {
          "type": "boolean"
        },
        "required_runner_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "mode",
        "renewal",
        "allow_node_local_device_session",
        "allow_secret_sync",
        "require_human_approval_for_brokered_user_auth"
      ]
    },
    "AuthMaterialKind": {
      "type": "string",
      "enum": [
        "api_token",
        "mcp_bearer_token",
        "oauth_access_token",
        "oauth_refresh_token",
        "oidc_id_token",
        "oidc_access_token",
        "oidc_refresh_token",
        "oidc_on_behalf_of_token",
        "device_auth_session",
        "workload_identity_token",
        "local_cli_session",
        "service_account",
        "other"
      ]
    },
    "AuthRenewalPolicy": {
      "type": "string",
      "enum": [
        "none",
        "manual_or_brokered",
        "broker_can_refresh",
        "runner_can_refresh"
      ]
    },
    "DeviceAuthProvider": {
      "type": "string",
      "enum": [
        "codex",
        "claude_code",
        "open_ai",
        "anthropic",
        "github",
        "google",
        "other"
      ]
    },
    "McpAccessMode": {
      "type": "string",
      "enum": [
        "single_user",
        "multi_user_oidc"
      ]
    },
    "McpAuthRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secret"
            },
            "secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "workload_identity"
            }
          },
          "required": [
            "kind",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "oauth_delegation"
            },
            "token_exchange_secret": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "token_exchange_secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string"
            },
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "issuer": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "oidc_delegation"
            },
            "principal": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UserPrincipalRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "require_user_consent": {
              "type": "boolean",
              "default": true
            },
            "token_ttl_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "broker",
            "issuer",
            "audience"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "device_auth_session"
            },
            "node_local": {
              "type": "boolean",
              "default": true
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "refresh_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "session_ref": {
              "$ref": "#/$defs/SecretRef"
            }
          },
          "required": [
            "kind",
            "session_ref",
            "provider"
          ]
        },
        {
          "type": "object",
          "properties": {
            "broker": {
              "$ref": "#/$defs/SecretRef"
            },
            "kind": {
              "type": "string",
              "const": "brokered_user_session"
            },
            "provider": {
              "$ref": "#/$defs/DeviceAuthProvider"
            },
            "requested_scopes": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "broker",
            "provider"
          ]
        }
      ]
    },
    "McpContextPropagation": {
      "type": "string",
      "enum": [
        "coordinator_issued",
        "runner_resolves_refs",
        "workload_identity",
        "runner_local_only",
        "oauth_device_broker",
        "external_broker"
      ]
    },
    "McpServerRef": {
      "type": "object",
      "properties": {
        "allowed_tools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "$ref": "#/$defs/McpAuthRef"
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "transport",
        "uri",
        "auth"
      ]
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "OidcDelegationPolicy": {
      "type": "object",
      "properties": {
        "allowed_mcp_servers": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "audiences": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "client_id": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "lease_ttl_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pass_id_token_to_mcp": {
          "type": "boolean",
          "default": false
        },
        "requested_scopes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "require_user_consent": {
          "type": "boolean",
          "default": true
        },
        "required_runner_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "token_broker": {
          "$ref": "#/$defs/SecretRef"
        },
        "token_cache_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "issuer",
        "client_id",
        "token_broker"
      ]
    },
    "SecretProvider": {
      "type": "string",
      "enum": [
        "env",
        "kubernetes_secret",
        "vault",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "azure_key_vault",
        "one_password",
        "bitwarden",
        "doppler",
        "sops",
        "external_broker",
        "local_file"
      ]
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/SecretProvider"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "UserPrincipalRef": {
      "type": "object",
      "properties": {
        "consent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "email_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "groups": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "issuer": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": "string"
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "issuer",
        "subject"
      ]
    }
  }
}
